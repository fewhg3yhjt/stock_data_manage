付款一般高于单笔里程碑款项。发行人尚无药品获批上市销售同时需要保持较高的研发投入,因此尚未实现持续盈利。基于持续研发投入,公司的注射用亚胺西福已提交新药上市申请,国际化BD交易顺利推进,公司较高的研发投入及经营亏损不会对公司持续经营能力构成重大不利影响。", "PREDICT_TYPE": "首亏", "PREYEAR_SAME_PERIOD": 359795100, "TRADE_MARKET": "上交所科创板", "TRADE_MARKET_CODE": "069001001006", "SECURITY_TYPE": "A股", "SECURITY_TYPE_CODE": "058001001", "INCREASE_JZ": -202.14, "FORECAST_JZ": -367500000, "FORECAST_STATE": "reduction", "IS_LATEST": "T", "PREDICT_RATIO_LOWER": null, "PREDICT_RATIO_UPPER": null, "PREDICT_HBMEAN": null}], "count": 49}, "success": true, "message": "ok", "code": 0}