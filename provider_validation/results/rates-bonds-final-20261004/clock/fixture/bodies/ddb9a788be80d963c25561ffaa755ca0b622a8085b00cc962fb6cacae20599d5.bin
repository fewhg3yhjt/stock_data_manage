券票面总金额;i:指可转换公司债券当年票面利率;t:指计息天数,即从上一个付息日起至本计息年度赎回日止的实际日历天数(算头不算尾)。若在前述三十个交易日内发生过转股价格调整的情形,则在调整前的交易日按调整前的转股价格和收盘价计算,调整后的交易日按调整后的转股价格和收盘价计算。","PARTY_NAME":"中证鹏元资信评估股份有限公司","CONVERT_STOCK_PRICE":32.18,"TRANSFER_PRICE":null,"TRANSFER_VALUE":null,"CURRENT_BOND_PRICE":null,"TRANSFER_PREMIUM_RATIO":null,"CONVERT_STOCK_PRICEHQ":null,"MARKET":null,"RESALE_TRIG_PRICE":null,"REDEEM_TRIG_PRICE":null,"PBV_RATIO":null,"IB_START_DATE":"2026-07-23 00:00:00","IB_END_DATE":"2027-07-22 00:00:00","CASHFLOW_DATE":"2027-07-23 00:00:00","COUPON_IR":2.8,"PARAM_NAME":"交易所系统网上向社会公众投资者发行,交易所系统网上向原A股无限售股东优先配售","ISSUE_TYPE":"1,4","EXECUTE_REASON_SH":"4","PAYDAYNEW":"-23","CURRENT_BOND_PRICENEW":null,"IS_CONVERT_STOCK":"否","IS_REDEEM":"是","IS_SELLBACK":"是","FIRST_PROFIT":336.141017562328,"PUBLIC_START_DATE_HOURS":"2021-07-23 15:00:00"},{"SECURITY_CODE":"113627","SECUCODE":"113627.SH","TRADE_MARKET":"CNSESH","SECURITY_NAME_ABBR":"太平转债","DELIST_DATE":null,"LISTING_DATE":"2021-08-06 00:00:00","CONVERT_STOCK_CODE":"603877","BOND_EXPIRE":"6","RATING":"AA","VALUE_DATE":"2021-07-15 00:00:00","ISSUE_YEAR":"2021","CEASE_DATE":"2027-07-14 00:00:00","EXPIRE_DATE":"2027-07-15 00:00:00","PAY_INTEREST_DAY":"07-15","INTEREST_RATE_EXPLAIN":"第一年0.30%、第二年0.50%、第三年1.00%、第四年1.50%、第五年1.80%、第六年2.00%。","BOND_COMBINE_CODE":"21270600001VEN","ACTUAL_ISSUE_SCALE":8,"ISSUE_PRICE":100,"REMARK":"本次发行的可转债向发行人在股权登记日(2021年7月14日,T-1日)收市后中国结算上海分公司登记在册的原股东优先配售,原股东优先配售后余额部分(含原股东放弃优先配售部分)采用网上通过上交所交易系统向社会公众投资者发售的方式进行,余额由保荐机构(主承销商)包销。","PAR_VALUE":100,"ISSUE_OBJECT":"(1)向发行人原股东优先配售:发行公告公布的股权登记日(2021年7月14日,T-1日)收市后中国结算上海分公司登记在册的发行人所有股东。(2)网上发行:持有中国证券登记结算有限责任公司上海分公司证券账户的自然人、法人、证券投资基金、符合法律规定的其他投资者等(国家法律、法规禁止者除外)。(3)本次发行的主承销商的自营账户不得参与网上申购。","REDEEM_TYPE":null,"EXECUTE_REASON_HS":"1","NOTICE_DATE_HS":"2026-08-26 00:00:00","NOTICE_DATE_SH":null,"EXECUTE_PRICE_HS":100.27,"EXECUTE_PRICE_SH":null,"RECORD_DATE_SH":null,"EXECUTE_START_DATESH":null,"EXECUTE_START_DATEHS":"2026-09-02 00:00:00","EXECUTE_END_DATE":"2026-09-08 00:00:00","CORRECODE":"