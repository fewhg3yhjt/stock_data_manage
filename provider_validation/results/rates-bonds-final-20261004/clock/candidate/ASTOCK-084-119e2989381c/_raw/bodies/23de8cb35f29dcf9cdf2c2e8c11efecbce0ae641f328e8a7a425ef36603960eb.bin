期转股价格的130%时,本公司董事会有权决定按面值加当期应计利息的价格赎回全部或部分未转股的可转换公司债券。本公司每年可按以上约定条件行使一次赎回权,但若在首次满足赎回条件不实施赎回的,当年不得再行使赎回权\n此外,当本次发行可转换公司债券未转股余额不足3,000 万元时,本公司董事会有权决定按面值加当期应计利息的价格赎回全部未转股的可转换公司债券","PARTY_NAME":"联合资信评估股份有限公司","CONVERT_STOCK_PRICE":2.04,"TRANSFER_PRICE":null,"TRANSFER_VALUE":null,"CURRENT_BOND_PRICE":null,"TRANSFER_PREMIUM_RATIO":null,"CONVERT_STOCK_PRICEHQ":null,"MARKET":null,"RESALE_TRIG_PRICE":null,"REDEEM_TRIG_PRICE":null,"PBV_RATIO":null,"IB_START_DATE":null,"IB_END_DATE":null,"CASHFLOW_DATE":null,"COUPON_IR":null,"PARAM_NAME":"交易所系统网上向社会公众投资者发行,交易所系统网上向原A股无限售股东优先配售,交易所系统网下向机构投资者协议发行,交易所系统网下向原A股有限售股东优先配售","ISSUE_TYPE":"1,2,4,5","EXECUTE_REASON_SH":null,"PAYDAYNEW":"-14","CURRENT_BOND_PRICENEW":null,"IS_CONVERT_STOCK":"否","IS_REDEEM":"是","IS_SELLBACK":"是","FIRST_PROFIT":497.379924238047,"PUBLIC_START_DATE_HOURS":"2007-12-14 15:00:00"},{"SECURITY_CODE":"126007","SECUCODE":"126007.SH","TRADE_MARKET":"CNSESH","SECURITY_NAME_ABBR":"07日照债","DELIST_DATE":"2013-11-27 00:00:00","LISTING_DATE":"2007-12-12 00:00:00","CONVERT_STOCK_CODE":"600017","BOND_EXPIRE":"6","RATING":"AAA","VALUE_DATE":"2007-11-27 00:00:00","ISSUE_YEAR":"2007","CEASE_DATE":"2013-11-26 00:00:00","EXPIRE_DATE":"2013-11-27 00:00:00","PAY_INTEREST_DAY":"11-27","INTEREST_RATE_EXPLAIN":"票面利率询价区间为1.40%-2.00%。最终票面利率将由发行人与保荐人（主承销商）根据簿记建档结果及网上、网下申购情况在上述询价区间范围内协商确定。","BOND_COMBINE_CODE":"07030600001ZGZ","ACTUAL_ISSUE_SCALE":8.8,"ISSUE_PRICE":100,"REMARK":null,"PAR_VALUE":100,"ISSUE_OBJECT":"原无限售条件A股流通股股东优先配售;网上向一般社会公众投资者发售","REDEEM_TYPE":null,"EXECUTE_REASON_HS":null,"NOTICE_DATE_HS":null,"NOTICE_DATE_SH":null,"EXECUTE_PRICE_HS":null,"EXECUTE_PRICE_SH":null,"RECORD_DATE_SH":null,"EXECUTE_START_DATESH":null,"EXECUTE_START_DATEHS":null,"EXECUTE_END_DATE":null,"CORRECODE":"733017","CORRECODE_NAME_ABBR":"日照发债","PUBLIC_START_DATE":"2007-11-27 00:00:00","CORRECODEO":"704017","CORRECODE_NAME_ABBRO":"日照配债","BOND_START_DATE":"2007-12-03 00:00:00","SECURITY_START_DATE":"2007-11-26 00:00:00","SECURITY_SHORT_NAME":"日照港","FIRST_