个交易日内发生过转股价格调整的情形,则在调整前的交易日按调整前的转股价格和收盘价格计算,调整后的交易日按调整后的转股价格和收盘价格计算。","PARTY_NAME":"中诚信国际信用评级有限责任公司","CONVERT_STOCK_PRICE":25.63,"TRANSFER_PRICE":null,"TRANSFER_VALUE":null,"CURRENT_BOND_PRICE":null,"TRANSFER_PREMIUM_RATIO":null,"CONVERT_STOCK_PRICEHQ":null,"MARKET":null,"RESALE_TRIG_PRICE":null,"REDEEM_TRIG_PRICE":null,"PBV_RATIO":null,"IB_START_DATE":null,"IB_END_DATE":null,"CASHFLOW_DATE":null,"COUPON_IR":null,"PARAM_NAME":"交易所系统网上向社会公众投资者发行,交易所系统网上向原A股无限售股东优先配售","ISSUE_TYPE":"1,4","EXECUTE_REASON_SH":"6","PAYDAYNEW":"-13","CURRENT_BOND_PRICENEW":null,"IS_CONVERT_STOCK":"否","IS_REDEEM":"是","IS_SELLBACK":"是","FIRST_PROFIT":29.847105299693,"PUBLIC_START_DATE_HOURS":"2017-11-13 15:00:00"},{"SECURITY_CODE":"113502","SECUCODE":"113502.SH","TRADE_MARKET":"CNSESH","SECURITY_NAME_ABBR":"嘉澳转债","DELIST_DATE":"2022-09-23 00:00:00","LISTING_DATE":"2017-11-27 00:00:00","CONVERT_STOCK_CODE":"603822","BOND_EXPIRE":"4.8712","RATING":"AA-","VALUE_DATE":"2017-11-10 00:00:00","ISSUE_YEAR":"2017","CEASE_DATE":"2022-09-22 00:00:00","EXPIRE_DATE":"2022-09-23 00:00:00","PAY_INTEREST_DAY":"11-10","INTEREST_RATE_EXPLAIN":"第一年0.4%、第二年0.6%、第三年1.0%、第四年1.5%、第五年1.8%、第六年2.0%。","BOND_COMBINE_CODE":"17270600001PFI","ACTUAL_ISSUE_SCALE":1.85,"ISSUE_PRICE":100,"REMARK":null,"PAR_VALUE":100,"ISSUE_OBJECT":"(1)向发行人的原股东优先配售:发行公告公布的股权登记日(即2017年11月9日,T-1日)收市后登记在册的发行人股东。(2)网上发行:中华人民共和国境内持有上交所证券账户的自然人、法人、证券投资基金以及符合法律法规规定的其他投资者(法律法规禁止购买者除外)。(3)本次发行的主承销商的自营账户不得参与网上申购。","REDEEM_TYPE":"2","EXECUTE_REASON_HS":null,"NOTICE_DATE_HS":null,"NOTICE_DATE_SH":"2022-09-01 00:00:00","EXECUTE_PRICE_HS":null,"EXECUTE_PRICE_SH":101.563,"RECORD_DATE_SH":"2022-09-22 00:00:00","EXECUTE_START_DATESH":"2022-09-23 00:00:00","EXECUTE_START_DATEHS":null,"EXECUTE_END_DATE":null,"CORRECODE":"754822","CORRECODE_NAME_ABBR":"嘉澳发债","PUBLIC_START_DATE":"2017-11-10 00:00:00","CORRECODEO":"753822","CORRECODE_NAME_ABBRO":"嘉澳配债","BOND_START_DATE":"2017-11-14 00:00:00","SECURITY_START_DATE":"2017-11-09 00:00:00","SECURITY_SHORT_NAME":"ST嘉澳"