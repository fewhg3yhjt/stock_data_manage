一个付息日起至本计息年度赎回日止的实际日历天数(算头不算尾)。若在前述三十个交易日内发生过转股价格调整的情形,则在转股价格调整日前的交易日按调整前的转股价格和收盘价计算,在转股价格调整日及之后的交易日按调整后的转股价格和收盘价计算。","PARTY_NAME":"中证鹏元资信评估股份有限公司","CONVERT_STOCK_PRICE":19.22,"TRANSFER_PRICE":null,"TRANSFER_VALUE":null,"CURRENT_BOND_PRICE":null,"TRANSFER_PREMIUM_RATIO":null,"CONVERT_STOCK_PRICEHQ":null,"MARKET":null,"RESALE_TRIG_PRICE":null,"REDEEM_TRIG_PRICE":null,"PBV_RATIO":null,"IB_START_DATE":null,"IB_END_DATE":null,"CASHFLOW_DATE":null,"COUPON_IR":null,"PARAM_NAME":"交易所系统网上向社会公众投资者发行,交易所系统网上向原A股无限售股东优先配售,交易所系统网下向原A股有限售股东优先配售","ISSUE_TYPE":"1,4,5","EXECUTE_REASON_SH":"6","PAYDAYNEW":"-24","CURRENT_BOND_PRICENEW":null,"IS_CONVERT_STOCK":"否","IS_REDEEM":"是","IS_SELLBACK":"是","FIRST_PROFIT":57.149775017041,"PUBLIC_START_DATE_HOURS":"2020-06-24 15:00:00"},{"SECURITY_CODE":"123056","SECUCODE":"123056.SZ","TRADE_MARKET":"CNSESZ","SECURITY_NAME_ABBR":"雪榕转债","DELIST_DATE":"2025-10-23 00:00:00","LISTING_DATE":"2020-07-24 00:00:00","CONVERT_STOCK_CODE":"300511","BOND_EXPIRE":"5.3123","RATING":"A","VALUE_DATE":"2020-06-24 00:00:00","ISSUE_YEAR":"2020","CEASE_DATE":"2025-10-14 00:00:00","EXPIRE_DATE":"2025-10-15 00:00:00","PAY_INTEREST_DAY":"06-24","INTEREST_RATE_EXPLAIN":"第一年0.4%、第二年0.7%、第三年1.0%、第四年1.5%、第五年2.5%、第六年3.0%。","BOND_COMBINE_CODE":"20270600001MET","ACTUAL_ISSUE_SCALE":5.85,"ISSUE_PRICE":100,"REMARK":"本次可转债向公司原股东优先配售,优先配售后余额部分(含原股东放弃优先配售部分)采用网上向社会公众投资者通过深交所交易系统发售的方式进行。认购不足5.85亿元的余额由主承销商包销。","PAR_VALUE":100,"ISSUE_OBJECT":"(1)向公司原股东优先配售:发行公告公布的股权登记日(2020年6月23日,T-1日)收市后登记在册的公司所有股东。(2)网上发行:中华人民共和国境内持有深交所证券账户的社会公众投资者,包括:自然人、法人、证券投资基金等(法律法规禁止购买者除外)。(3)本次发行的承销团成员的自营账户不得参与网上申购。","REDEEM_TYPE":"2","EXECUTE_REASON_HS":"3","NOTICE_DATE_HS":"2022-07-20 00:00:00","NOTICE_DATE_SH":"2025-09-04 00:00:00","EXECUTE_PRICE_HS":100.104,"EXECUTE_PRICE_SH":100.93,"RECORD_DATE_SH":"2025-10-14 00:00:00","EXECUTE_START_DATESH":"2025-10-15 00:00:00","EXECUTE_START_DATEHS":"2022-08-01 00:00:00","EXECUTE_END_DATE":"2022-08-05 00:00:00","CORRECODE":"370511","CORRECODE_NAME_ABBR":"雪榕发债","PUB