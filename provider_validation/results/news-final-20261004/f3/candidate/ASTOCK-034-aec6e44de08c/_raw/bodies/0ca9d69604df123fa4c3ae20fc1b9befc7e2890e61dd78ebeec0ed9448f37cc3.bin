5370\u5ea6\u7b49\u5730\u9020\u6210\u95ee\u9898\u3002\u6bd4\u7f57\u5c14\u8868\u793a\uff0c\u7a0d\u540e\u8fd8\u5c06\u5c31\u662f\u5426\u91ca\u653e\u6218\u7565\u50a8\u5907\u53d1\u8868\u8bb2\u8bdd\u3002</p>\n", "content_more": "", "content_text": "\u56fd\u9645\u80fd\u6e90\u7f72(IEA)\u7f72\u957f\u6bd4\u7f57\u5c14(Fatih Birol)\u8868\u793a\uff0c\u5bf9\u67f4\u6cb9\u4ef7\u683c\u975e\u5e38\u62c5\u5fe7\uff0c\u6b27\u6d32\u548c\u7f8e\u56fd\u67f4\u6cb9\u4ef7\u683c\u5df2\u8fbe\u5386\u53f2\u9ad8\u4f4d\u3002\u67f4\u6cb9\u4ef7\u683c\u4e0a\u6da8\u5c06\u5728\u672a\u6765\u51e0\u4e2a\u6708\u63a8\u9ad8\u519c\u4ea7\u54c1\u901a\u80c0\u3002\u6db2\u5316\u77f3\u6cb9\u6c14\u4ef7\u683c\u4e5f\u5728\u975e\u6d32\u3001\u5370\u5ea6\u7b49\u5730\u9020\u6210\u95ee\u9898\u3002\u6bd4\u7f57\u5c14\u8868\u793a\uff0c\u7a0d\u540e\u8fd8\u5c06\u5c31\u662f\u5426\u91ca\u653e\u6218\u7565\u50a8\u5907\u53d1\u8868\u8bb2\u8bdd\u3002", "cover_images": [], "display_time": 1790844024, "fund_codes": [], "global_channel_name": "7x24\u5feb\u8baf", "global_more_uri": "wscn://wallstreetcn.com/live", "has_live_reading": false, "highlight_title": "", "id": 3173321, "images": [], "is_calendar": false, "is_favourite": false, "is_priced": false, "is_scaling": false, "reference": "", "related_themes": [], "score": 1, "symbols": [], "tags": [], "title": "IEA\u7f72\u957f\u6bd4\u7f57\u5c14\uff1a\u6b27\u6d32\u53ca\u5168\u7403\u67f4\u6cb9\u5e02\u573a\u201c\u975e\u5e38\u7d27\u5f20\u201d", "type": "live", "uri": "https://wallstreetcn.com/livenews/3173321"}, {"article": null, "author": {"avatar": "https://wpimg-wscn.awtmt.com/478b50b9-9fd3-4275-afc0-f1f5e83cbf37", "display_name": "\u845b\u51ac\u747e", "id": 120000004519, "is_followed": false, "uri": "https://wallstreetcn.com/authors/120000004519"}, "ban_comment": false, "channels": ["global-channel", "forex-channel", "a-stock-channel", "xgb-channel"], "comment_count": 0, "content": "<p>Gavekal Research\u7ecf\u6d4e\u5b66\u5bb6Cedric Gemehl\u8868\u793a\uff0c\u968f\u7740\u660e\u5e74\u603b\u7edf\