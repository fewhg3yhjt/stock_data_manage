revised":"","period":"周","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/US141131/overview","assets":"cmd","foresight":""},{"id":1590876,"public_date":1789149600,"observation_date":"2026-08-01","wscn_ticker":"US181222","country":"美国","title":"8月政府预算(亿美元)","event":"政府预算","country_id":"US","quantity":"b","unit":"亿美元","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"e02a60e86e3d7a4aac994339916c34bc","actual":"-1667.97","forecast":"-2200","previous":"-3448","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/US181222/overview","assets":"cmd,fx,bd,stk@us","foresight":""},{"id":15092,"public_date":1789155000,"observation_date":"","wscn_ticker":"","country":"美国","title":"CFTC公布周度持仓报告。","event":"","country_id":"US","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15197,"public_date":1789178880,"observation_date":"","wscn_ticker":"","country":"中国","title":"华为 Mate XT 2 非凡大师 三折叠开售","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 华为三折叠 Mate XT 2 非凡大师9月12日10:08开售（19999元起，麒麟9050 Pro），系折叠机品类标杆。在华为系终端热度与折叠屏供应链高景气下，开售首周销量与缺货情况将检验高端机型需求，并带动铰链/屏/结构件环节情绪。"},{"id":15060,"public_date":1789185720,"observation_date":"","wscn_ticker":"","country":"美国","title":"特朗普预计将于9月12日访问爱尔兰","event":"","country_id":"US","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 特朗普预计将于9月12日访问爱尔兰。（爱尔兰时报）"},{"id":15056,"public_date":1789185720,"observation_date":"","wscn_ticker":"","country":"美国","title":"马斯克：预计9月12日后发布Grok 4.7模型","event":"","country_id":"US","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月2日，马斯克在X平台发布推文，预告将会在10天后发布Grok 4.7模型。Grok 4.7模型参数规模达到2.1万亿，相比较Grok 4.6（1.5万亿）增涨40%。"},{"id":15010,"public_date":1789185720,"observation_date":"","wscn_ticker":"","country":"印度","title":"金砖国家领导人第十八次会晤将于9月12日至13日在新德里举行","event":"","country_id":"IN","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/64bbee66-750e-43a5-ba25-ea15b5d1969b.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 据印度外交部当地时间8月27日消息，印度将于2026年9月12日至13日在新德里举办金砖国家领导人第十八次会晤。（央视）"},{"id":15099,"public_date":1789198200,"observation_date":"","wscn_ticker":"","country":"法国","title":"欧洲央行行长拉加德发表讲话。","event":"","country_id":"FR","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/e9233c15-d567-4992-87ad-563a74b1dd4c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15120,"public_date":1789228800,"observation_date":"","wscn_ticker":"","country":"中国","title":"亚德诺（ADI）年内第二轮全产品组合价格调整生效","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月13日起，亚德诺将实施2026年第二轮全产品组合价格调整。据ADI首席客户官中村胜签发的客户函，本轮覆盖商业、工业及军用高可靠全系列，新价适用于所有未发货订单，部分\"/883\"后缀军用合格器件涨幅可达30%；ADI明确涨价所得全部再投资于内部晶圆厂、封装与测试扩产，以缓解最长六个月的交期。"},{"id":15124,"public_date":1789315200,"observation_date":"","wscn_ticker":"","country":"韩国","title":"韩国交易所将于9月14日推出股票盘后交易","event":"","country_id":"KR","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/2dc5aac7-658f-4501-b93d-cb03dd66b0ca.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 韩国交易所表示，将于9月14日推出Kospi和Kosdaq股票的盘后交易服务，交易时间延长至晚上8点。盘后交易时间为下午4点至晚上8点，将进行不间断的实时交易，取代当前下午4点至6点的集合竞价交易机制。符合条件的证券包括Kospi和Kosdaq上市股票以及存托凭证(DR)，但不包括交易所交易基金(ETF)、交易所交易票据(ETN)以及受到特定市场管控措施限制的股票。"},{"id":15064,"public_date":1789348800,"observation_date":"","wscn_ticker":"","country":"中国","title":"纳真科技计划最早于9月14日在香港启动IPO","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 中国光通信设备制造商纳真科技计划最早于9月14日在香港启动IPO，目标融资额约为8亿美元。（路透）"},{"id":15059,"public_date":1789348800,"observation_date":"","wscn_ticker":"","country":"中国","title":"科创板指数将进行2026年三季度调样正式生效","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 上交所发布关于科创50等指数三季度定期调整结果公告。根据指数编制规则，科创50等科创指数样本每季度进行定期调整，本次调整将于9月11日收市后实施。睿创微纳、华丰科技、屹唐股份、影石创新、盛合晶微等5只证券将被调入科创50指数，杰普特、长光华芯、凯赛生物等10只证券将被调入科创100指数。"},{"id":15058,"public_date":1789348800,"observation_date":"","wscn_ticker":"","country":"中国","title":"文远知行入选香港交易所科技100指数正式生效","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 自动驾驶科技公司文远知行WeRide宣布，根据香港交易所公布的科技100指数季度调整结果，公司获纳入港交所科技100指数成份股，调整将于9月11日收市后实施，并于9月14日起正式生效。"},{"id":15211,"public_date":1789351200,"observation_date":"","wscn_ticker":"","country":"中国","title":"“开局起步‘十五五’”系列主题新闻发布会","event":"","country_id":"CN","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 据国新网，国务院新闻办公室将于2026年9月14日（星期一）上午10时举行“开局起步‘十五五’”系列主题新闻发布会，请国家卫生健康委主任雷海潮，国家卫生健康委副主任、国家中医药局局长刘金峰，国家卫生健康委副主任、国家疾控局局长沈洪兵，国家卫生健康委新闻发言人、副主任郭燕红介绍推动健康中国建设取得决定性进展有关情况，并答记者问。\n\n\n\n\n\n\n此外，国务院新闻办公室将于2026年9月14日（星期一）下午3时举行国务院政策例行吹风会，请工业和信息化部副部长柯吉欣和中国人民银行、国务院国资委、市场监管总局、中国证监会有关负责人介绍加强中小企业回款难问题治理有关工作情况，并答记者问。"},{"id":15158,"public_date":1789353000,"observation_date":"","wscn_ticker":"","country":"澳大利亚","title":"澳洲联储助理主席亨特参加一场炉边谈话。","event":"","country_id":"AU","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg","calendar_key":"","actual":"","for