e":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":1590805,"public_date":1788861600,"observation_date":"2026-08-01","wscn_ticker":"US151153","country":"美国","title":"8月NFIB中小企业乐观程度指数","event":"NFIB中小企业乐观程度指数","country_id":"US","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"3dbecf7c4804a23752645149f53b980d","actual":"98.7","forecast":"99.2","previous":"99.8","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/US151153/overview","assets":"cmd,fx,bd,stk@us","foresight":""},{"id":15107,"public_date":1788879600,"observation_date":"","wscn_ticker":"","country":"德国","title":"欧洲央行执委埃尔德森发表讲话。","event":"","country_id":"DE","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef7b465-a541-4a9b-bd14-d88983aa1f31.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":14959,"public_date":1788883200,"observation_date":"","wscn_ticker":"","country":"美国","title":"美国财政部长债回购翻倍预计将于9月9日起生效","event":"","country_id":"US","quantity":"","unit":"","importance":4,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 美国财政部宣布将把较长期名义附息国债的流动性支持回购操作单次最高规模至少提高一倍，至至少40亿美元，自2026年9月9日起生效。这一安排将从2026年9月9日持续至11月4日。\n\n美国财政部将于9月9日启动扩大版长期美债回购计划，持续至11月4日。此举旨在改善长端美债市场流动性，为新债发行营造有利条件。回购计划启动时间与美国CPI、PPI数据及欧央行决议高度重叠，市场对长端利率的走势判断将更趋复杂，彭博新闻指出当前市场加息押注升温，长端供需动态值得关注。"},{"id":1590812,"public_date":1788894000,"observation_date":"2026-07-01","wscn_ticker":"US191240","country":"美国","title":"7月消费信贷变动(亿美元)","event":"消费信贷变动","country_id":"US","quantity":"b","unit":"亿美元","importance":2,"mark":"BB","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"a3d89f3b5dbbe5f496b4e561c0078aee","actual":"180.62","forecast":"113.4","previous":"141.73","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/US191240/overview","assets":"fx,bd,stk@us","foresight":""},{"id":15093,"public_date":1788910800,"observation_date":"","wscn_ticker":"","country":"新西兰","title":"新西兰联储助理主席西尔克发表讲话。","event":"","country_id":"NZ","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/f068dcff-7a21-4415-94e9-d2c73791400c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":1590814,"public_date":1788911400,"observation_date":"2026-08-01","wscn_ticker":"JP191887","country":"日本","title":"8月货币存量M3同比","event":"货币存量M3同比","country_id":"JP","quantity":"","unit":"%","importance":1,"mark":"BB","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg","calendar_key":"a6000b234157c1f49028656192fa776c","actual":"1.2","forecast":"","previous":"1.4","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/JP191887/overview","assets":"fx","foresight":""},{"id":1590813,"public_date":1788911400,"observation_date":"2026-08-01","wscn_ticker":"JP191886","country":"日本","title":"8月货币存量M2同比","event":"货币存量M2同比","country_id":"JP","quantity":"","unit":"%","importance":1,"mark":"BB","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg","calendar_key":"149d9defcbbdd51fb305ab0913018303","actual":"2","forecast":"","previous":"2.2","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/JP191886/overview","assets":"fx","foresight":""},{"id":15117,"public_date":1788916800,"observation_date":"","wscn_ticker":"","country":"中国","title":"优地机器港股上市（拟发行 4500 万股 H 股）","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":1590816,"public_date":1788917400,"observation_date":"2026-08-01","wscn_ticker":"CN111275","country":"中国","title":"8月CPI同比","event":"CPI同比","country_id":"CN","quantity":"","unit":"%","importance":4,"mark":"BB","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"6c6982c52f6a30ea526b622efd25d455","actual":"0.8","forecast":"","previous":"0.5","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/CN111275/overview","assets":"cmd,fx,bd,stk@cn,stk@hk","foresight":"前瞻 | 国家统计局将于9月9日发布8月物价数据。华创证券张瑜团队预计CPI同比回升至0.9%左右。中国海关总署将于同日公布8月进出口数据。看点是AI产业链支撑的高景气能否延续，以及“抢出口”退坡后的动能变化，直接影响外贸与航运板块预期。下周，8月金融数据也预计出炉。此外，国家外汇管理局将于9月7日公布8月末外汇储备，7月末为34187.8亿美元，央行再度增持黄金。"},{"id":1590815,"public_date":1788917400,"observation_date":"2026-08-01","wscn_ticker":"CN111291","country":"中国","title":"8月PPI同比","event":"PPI同比","country_id":"CN","quantity":"","unit":"%","importance":4,"mark":"BB","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"ebd3167457e31b613ecd8d106131b8b6","actual":"3.8","forecast":"","previous":"3.5","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/CN111291/overview","assets":"cmd,fx,bd,stk@cn,stk@hk","foresight":""},{"id":15094,"public_date":1788919200,"observation_date":"","wscn_ticker":"","country":"泰国","title":"泰国央行公布货币政策会议纪要。","event":"","country_id":"TH","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/c7b8e14a-2243-4af6-8e39-563a22ef15d3.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15116,"public_date":1788921300,"observation_date":"","wscn_ticker":"","country":"中国","title":"财政部第二次续发行2026年超长期特别国债（三期）","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月9日10:35至11:35，财政部将通过北交所政府债券发行系统第二次续发行2026年超长期特别国债（三期）。据财政部财办债〔2026〕189号通知，本次为50年期固定利率附息债，竞争性招标面值总额350亿元，票面利率2.52%，不进行甲类成员追加投标，9月14日起合并上市交易。"},{"id":15126,"public_date":1788926520,"observation_date":"","wscn_ticker":"","country":"法国","title":"巴黎太空峰会，SpaceX、Blue Origin等美企取消参会","event":"","country_id":"FR","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/e9233c15-d567-4992-87ad-563a74b1dd4c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月9日至10日，法国总统马克龙将在巴黎大皇宫主办国际太空峰会，预计约120个国家派代表团出席。据POLITICO，在白宫施压下，SpaceX、Blue Origin、Stoke Space与Starcloud四家美国航天企业已于周四通知法方取消参会，法方称\"很难不将此与媒体流传的施压传闻联系起来\"。看点是欧美在《欧盟太空法》与IRIS²卫星频率分配上的分歧如何演化；影响：欧洲自主航天供应链与卫星通信产业链的政策预期，以及美欧科技主权博弈的定价。"},{"id":15115,"public_date":1788926520,"observation_date":"","wscn_ticker":"","country":"中国","title":"2026 Inclusion·外滩大会（上海黄浦世博园区）","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月9日至12日，2026 Inclusion·外滩大会将在上海黄浦世博园区举行。据外滩大会官网，本届以\"共创AI新经济\"为主题，设1场主论坛、40余场见解论坛，汇聚600余位嘉宾，报名人数已突破5万人。看点是围绕AI付、智能体商业的系列发布与蚂蚁国际 Voyage 技术大会首次驻场；影响：AI 应用与金融科技板块的事件驱动。"},{"id":15113,"public_date":1788926520,"observation_date":"","wscn_ticker":"","country":"美国","title":"美国共和党首届中期选举大会，特朗普将发表演讲","event":"","country_id":"US","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 美国共和党全国委员会定于2026年9月9日至10日在得克萨斯州达拉斯举行首届中期选举大会，美国总统唐纳德·特朗普和副总统万斯预计将在会上发表主旨演讲。"},{"id":15112,"public_date":1788926520,"observation_date":"","wscn_ticker":"","country":"中国","title":"“一带一路高峰论坛”在香港举行，李家超出席","event":"","country_id":"CN","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 第11届“一带一路高峰论坛”于2026年9月9日至10日在香港会议展览中心举行，香港特区行政长官李家超出席并担任首日高层政商交流环节的演讲嘉宾。"},{"id":15081,"public_date":1788926520,"observation_date":"","wscn_ticker":"","country":"中国","title":"钢谷网公布中西部建材产量和库存","event":"","country_id":"CN","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15036,"public_date":1788926520,"observation_