影响外贸与航运板块预期。下周，8月金融数据也预计出炉。此外，国家外汇管理局将于9月7日公布8月末外汇储备，7月末为34187.8亿美元，央行再度增持黄金。"},{"id":1590800,"public_date":1788843600,"observation_date":"2026-08-01","wscn_ticker":"JP151824","country":"日本","title":"8月经济观察家前景指数","event":"经济观察家前景指数","country_id":"JP","quantity":"","unit":"","importance":1,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg","calendar_key":"94a5f4dec554dfe7c1c7845b81725716","actual":"48.3","forecast":"46.4","previous":"45.8","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/JP151824/overview","assets":"fx","foresight":""},{"id":1590799,"public_date":1788843600,"observation_date":"2026-08-01","wscn_ticker":"JP151823","country":"日本","title":"8月经济观察家现况指数","event":"经济观察家现况指数","country_id":"JP","quantity":"","unit":"","importance":1,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg","calendar_key":"ed1d23ad9864b1a08170cdeae8670405","actual":"46.4","forecast":"46.2","previous":"45.7","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/JP151823/overview","assets":"fx","foresight":""},{"id":1590802,"public_date":1788847200,"observation_date":"2026-07-01","wscn_ticker":"DE132180","country":"德国","title":"7月季调后进口环比","event":"季调后进口环比","country_id":"DE","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/cef7b465-a541-4a9b-bd14-d88983aa1f31.jpg","calendar_key":"ac282ece103e4a86bc8def9e830a146e","actual":"-5.7","forecast":"","previous":"4.4","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/DE132180/overview","assets":"fx,bd","foresight":""},{"id":1590801,"public_date":1788847200,"observation_date":"2026-07-01","wscn_ticker":"DE132179","country":"德国","title":"7月季调后出口环比","event":"季调后出口环比","country_id"