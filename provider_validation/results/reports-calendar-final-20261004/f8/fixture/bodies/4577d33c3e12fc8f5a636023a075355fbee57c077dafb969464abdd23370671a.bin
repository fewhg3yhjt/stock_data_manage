{"code":20000,"message":"OK","data":{"items":[{"id":15037,"public_date":1788796800,"observation_date":"","wscn_ticker":"","country":"加拿大","title":"加拿大反制关税生效：对美200亿美元等额反制关税","event":"","country_id":"CA","quantity":"","unit":"","importance":4,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/15d3eea2-c2f2-4f80-90b9-e95764031c01.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 据新华社，加拿大政府于25日周二宣布，对价值约200亿美元的美国商品征收报复性关税。据央视新闻，加拿大政府表示，自9月8日起，将对约700种美国产品征收反制关税，税率分别为15%、25%或50%；同时将推出75亿加元的援助计划，支持受美国新关税影响的企业和工人。"},{"id":1590783,"public_date":1788822000,"observation_date":"2026-04-01","wscn_ticker":"KR103232","country":"韩国","title":"二季度GDP同比初值","event":"GDP同比","country_id":"KR","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/2dc5aac7-658f-4501-b93d-cb03dd66b0ca.jpg","calendar_key":"3936c8bf000698ab9ec96d91a568573f","actual":"3.7","forecast":"3.7","previous":"3.7","revised":"","period":"季","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/KR103232/overview","assets":"fx","foresight":""},{"id":1590782,"public_date":1788822000,"observation_date":"2026-04-01","wscn_ticker":"KR103239","country":"韩国","title":"二季度GDP环比初值","event":"GDP环比","country_id":"KR","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/2dc5aac7-658f-4501-b93d-cb03dd66b0ca.jpg","calendar_key":"2a70a9bfaf8b5a870c8a0881dee3b120","actual":"0.6","forecast":"0.6","previous":"0.6","revised":"","period":"季","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/KR103239/overview","assets":"fx","foresight":""},{"id":1590784,"public_date":1788822060,"observation_date":"2026-08-01","wscn_ticker":"UK171661","country":"英国","title":"8月BRC同店销售同比","event":"BRC同店销售同比","country_id":"UK","quantity":