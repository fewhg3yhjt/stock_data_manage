":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 恒大汽车在港交所公告，公司将于2026年9月8日（星期二）及2026年9月16日（星期三）举行董事会会议，藉以（其中包括）审议及批准集团的财务业绩。于2026年9月8日举行的会议上，董事会将审议及批准截至2024年及2025年12月31日止年度的年度业绩，以及截至2025年6月30日止六个月的中期业绩。"},{"id":1590811,"public_date":1788840120,"observation_date":"2026-08-01","wscn_ticker":"CN131323","country":"中国","title":"8月贸易帐(按人民币计)(亿人民币)","event":"贸易帐(按人民币计)","country_id":"CN","quantity":"b","unit":"亿人民币","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"607a8652274de4d00cfcf00aff6e9cd7","actual":"8093","forecast":"","previous":"7670.7","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/CN131323/overview","assets":"cmd,fx,bd,stk@cn,stk@hk","foresight":""},{"id":1590810,"public_date":1788840120,"observation_date":"2026-08-01","wscn_ticker":"CN131327","country":"中国","title":"8月进口同比(按人民币计)","event":"进口同比(按人民币计)","country_id":"CN","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"148fcac1607ba6a0a61beac097723f80","actual":"21.7","forecast":"","previous":"21.2","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/CN131327/overview","assets":"cmd,fx,bd,stk@cn,stk@hk","foresight":""},{"id":1590809,"public_date":1788840120,"observation_date":"2026-08-01","wscn_ticker":"CN131326","country":"中国","title":"8月出口同比(按人民币计)","event":"出口同比(按人民币计)","country_id":"CN","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"a18275d143d4ebaecf71090501518ada","actual":"18.6","forecast":"","previous":"17.8","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/CN13