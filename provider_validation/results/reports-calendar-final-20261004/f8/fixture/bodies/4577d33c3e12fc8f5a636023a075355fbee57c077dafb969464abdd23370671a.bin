司计划发行约2600万股股份，发售价不超过每股240.6港元，较其上周五在深圳上市的A股收盘价折让约45%。江波龙预计9月8日在香港挂牌上市。若行使增发选择权，募资规模最高可达到10.6亿美元。"},{"id":1590798,"public_date":1788831000,"observation_date":"2026-08-01","wscn_ticker":"AU152806","country":"澳大利亚","title":"8月NAB商业景气指数","event":"NAB商业景气指数","country_id":"AU","quantity":"","unit":"","importance":1,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg","calendar_key":"1481080d4d0510f9ed2acb6a7fd564f3","actual":"-1","forecast":"","previous":"4","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/AU152806/overview","assets":"fx","foresight":""},{"id":1590797,"public_date":1788831000,"observation_date":"2026-08-01","wscn_ticker":"AU152807","country":"澳大利亚","title":"8月NAB商业信心指数","event":"NAB商业信心指数","country_id":"AU","quantity":"","unit":"","importance":1,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg","calendar_key":"575f6e5a59bf4322a196ba8f7e2c90e0","actual":"-8","forecast":"","previous":"-6","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/AU152807/overview","assets":"fx","foresight":""},{"id":15095,"public_date":1788837600,"observation_date":"","wscn_ticker":"","country":"澳大利亚","title":"澳洲联储助理主席亨特发表讲话。","event":"","country_id":"AU","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15080,"public_date":1788840120,"observation_date":"","wscn_ticker":"","country":"中国","title":"第二十六届中国国际投资贸易洽谈会于9月8日至11日在福建厦门举行。","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.c