rview", "assets": "fx", "foresight": ""}, {"id": 1589110, "public_date": 1788226200, "observation_date": "2026-04-01", "wscn_ticker": "AU132751", "country": "澳大利亚", "title": "二季度经常帐(亿澳元)", "event": "经常帐", "country_id": "AU", "quantity": "b", "unit": "亿澳元", "importance": 1, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg", "calendar_key": "ee0da8e9fddc5dca74d68ec866052bc4", "actual": "-272", "forecast": "", "previous": "-271", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/AU132751/overview", "assets": "fx", "foresight": ""}, {"id": 1589112, "public_date": 1788227100, "observation_date": "2026-08-01", "wscn_ticker": "CN151371", "country": "中国", "title": "8月RatingDog制造业PMI", "event": "RatingDog制造业PMI", "country_id": "CN", "quantity": "", "unit": "", "importance": 3, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "878f3dabe8f3a4c89d3c566666d967e7", "actual": "51.5", "forecast": "", "previous": "50.9", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/CN151371/overview", "assets": "cmd,fx,bd,stk@cn,stk@hk", "foresight": ""}, {"id": 15053, "public_date": 1788235320, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "2026年上合组织成员国元首理事会会议举行", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 2026年上合组织成员国元首理事会会议举行。"}, {"id": 15039, "public_date": 1788235320, "observation_date": "", "wscn_ticker": "", "country": "日本", "title": "日本将举行两场国债拍卖，美债考验时刻再至", "event": "", "country_id": "JP", "quantity": "", "unit": "", "importance": 4, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 据彭博报道，将于下周（8月31日当周）举行的两场日本国债拍卖可能考验贝森特压低长期美债收益率的努力。日本将在9月1日发行10年期国债，并在两天后发行30年期国债。"}, {"id": 15018, "public_date": 1788235320, "observation_date": "", "wscn_ticker": "", "country": "俄罗斯", "title": "乌俄或于9月重启谈判（美方参与）", "event": "", "country_id": "RU", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/b7781de7-a74b-46ef-bcc8-665d61ac09c4.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 据新华社报道，乌克兰总统办公室主任布达诺夫27日在接受乌媒采访时表示，乌克兰与俄罗斯可能在9月重启谈判进程。\n布达诺夫说，目前乌俄谈判进程处于停滞状态，但双方计划“重新启动”该进程。他透露，在美国参与下，乌俄双方代表团最快将在9月恢复接触。"}, {"id": 15011, "public_date": 1788235320, "observation_date": "", "wscn_ticker": "", "country": "美国", "title": "G20科技部长级会议，马斯克、黄仁勋、奥特曼等科技巨头出席", "event": "", "country_id": "US", "quantity": "", "unit": "", "importance": 4, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 据彭博报道，G20科技部长级会议将于9月1日至2日在美国北卡罗来纳州举行，马斯克、黄仁勋、奥特曼等科技巨头出席，特朗普政府推动与会各方接受\"卡罗来纳原则\"——主张AI轻监管、避免新增监管机构。"}, {"id": 1589114, "public_date": 1788238800, "observation_date": "2026-08-01", "wscn_ticker": "JP171867", "country": "日本", "title": "8月家庭消费者信心指数", "event": "家庭消费者信心指数", "country_id": "JP", "quantity": "", "unit": "", "importance": 1, 