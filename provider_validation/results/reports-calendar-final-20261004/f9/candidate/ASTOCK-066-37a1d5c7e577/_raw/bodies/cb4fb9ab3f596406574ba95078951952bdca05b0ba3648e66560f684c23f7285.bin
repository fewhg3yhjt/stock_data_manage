uri": "", "assets": "", "foresight": ""}, {"id": 1589204, "public_date": 1788478200, "observation_date": "2026-07-01", "wscn_ticker": "JP171850", "country": "日本", "title": "7月所有家庭支出同比", "event": "所有家庭支出同比", "country_id": "JP", "quantity": "", "unit": "%", "importance": 1, "mark": "BB", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg", "calendar_key": "6fbc2bc57cf2272da32cc58391ffb675", "actual": "-3.6", "forecast": "-1.6", "previous": "-3.3", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/JP171850/overview", "assets": "fx", "foresight": ""}, {"id": 15063, "public_date": 1788480000, "observation_date": "", "wscn_ticker": "", "country": "韩国", "title": "韩国财长将于周五召开市场评估会议", "event": "", "country_id": "KR", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/2dc5aac7-658f-4501-b93d-cb03dd66b0ca.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 韩国财政部将于当地时间周五上午8点（北京时间上午7点）召开市场评估会议。"}, {"id": 14981, "public_date": 1788494400, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "第32次亚太经合组织中小企业部长会议将在广州举行", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 2, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 |  从工业和信息化部了解到，第32次APEC中小企业部长会议将于9月4日在广东省广州市举行。本次会议以“创新驱动 合作共赢”为主题，各方将共同探讨促进亚太中小企业发展的合作路径。\n   据了解，在本次会议期间，还将举办第二十一届中国国际中小企业博览会。预计将有超40个国家（地区）及国际组织的500余家优质境外企业参展，参展展品涵盖智能科技、生物医药、跨境服务等多个领域，全方位展现全球中小企业创新活力与经贸合作潜力。境外参展企业和机构覆盖全部亚太经合组织（APEC）成员经济体。（央视）"}, {"id": 1589206, "public_date": 1788501600, "observation_date": "2026-07-01", "wscn_ticker": "DE142221", "country": "德国", "title": "7月季调后工厂订单同比", "event": "季调后工厂订单同比", "country_id": "DE", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/cef7b465-a541-4a9b-bd14-d88983aa1f31.jpg", "calendar_key": "0e9906c336a591f36960d0380b7e6ebc", "actual": "13.1", "forecast": "10.5", "previous": "6.5", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/DE142221/overview", "assets": "fx,bd", "foresight": ""}, {"id": 1589205, "public_date": 1788501600, "observation_date": "2026-07-01", "wscn_ticker": "DE142222", "country": "德国", "title": "7月季调后工厂订单环比", "event": "季调后工厂订单环比", "country_id": "DE", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/cef7b465-a541-4a9b-bd14-d88983aa1f31.jpg", "calendar_key": "83f6f6702eee2b3a5a66f057fd83abaa", "actual": "2.5", "forecast": "0.3", "previous": "3.1", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/DE142222/overview", "assets": "fx,bd", "foresight": ""}, {"id": 1589208, "public_date": 1788508800, "observation_date": "2026-07-01", "wscn_ticker": "IT172592", "country": "意大利", "title": "7月零售销售同比", "event": "零售销售同比", "country_id": "IT", "quantity": "", "unit": "%", "importance": 1, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/9b965b7e-2c02-47e6-aa60-682be239545a.jpg", "calendar_key": "cd3d2d733adbe684e0b250b5ec3ae6ce", "actual": "0.8", "forecast": "", "previous": "3.1", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/IT172592/overview", "assets": "fx", "foresight": ""}, {"id": 1589207, "public_date": 1788508800, "observation_date": "2026-07-01", "wscn_t