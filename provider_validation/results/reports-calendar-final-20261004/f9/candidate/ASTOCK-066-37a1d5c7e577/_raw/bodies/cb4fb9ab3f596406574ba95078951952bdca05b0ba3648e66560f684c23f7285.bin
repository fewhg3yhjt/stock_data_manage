untry_id": "JP", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 日本央行将于9月17-18日召开政策会议，据共同社报道市场押注加息概率超80%，利率或由1%升至1.25%。日元逼近160、套息交易重燃，若加息落地将冲击全球套利资金与日股，并外溢至全球风险偏好；高田创（9/2）、增田和也（9/10）讲话为前瞻信号。"}, {"id": 1589150, "public_date": 1788312600, "observation_date": "2026-04-01", "wscn_ticker": "AU102655", "country": "澳大利亚", "title": "二季度GDP同比", "event": "GDP同比", "country_id": "AU", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg", "calendar_key": "4264b70ea110fafdec1720382803a254", "actual": "2.1", "forecast": "1.9", "previous": "2.5", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/AU102655/overview", "assets": "fx", "foresight": ""}, {"id": 1589149, "public_date": 1788312600, "observation_date": "2026-04-01", "wscn_ticker": "AU102665", "country": "澳大利亚", "title": "二季度GDP季环比", "event": "GDP季环比", "country_id": "AU", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/dcb7cb6c-b858-48e9-934a-35addef7be1b.jpg", "calendar_key": "21636d9b8d7046e35581a78ec281a402", "actual": "0.4", "forecast": "0.4", "previous": "0.3", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/AU102665/overview", "assets": "fx", "foresight": ""}, {"id": 14988, "public_date": 1788314400, "observation_date": "", "wscn_ticker": "", "country": "新西兰", "title": "新西兰联储公布利率决议", "event": "", "country_id": "NZ", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/f068dcff-7a21-4415-94e9-d2c73791400c.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 新西兰联储公布利率决议和货币政策声明。"}, {"id": 1589151, "public_date": 1788314400, "observation_date": "2026-09-02", "wscn_ticker": "NZ193031", "country": "新西兰", "title": "官方现金利率", "event": "官方现金利率", "country_id": "NZ", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/f068dcff-7a21-4415-94e9-d2c73791400c.jpg", "calendar_key": "90ebb9573bb9ca87c97788c532442759", "actual": "2.75", "forecast": "2.75", "previous": "2.5", "revised": "", "period": "日", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/NZ193031/overview", "assets": "fx", "foresight": ""}, {"id": 15052, "public_date": 1788321720, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "SEMICON Taiwan国际半导体展", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | SEMICON Taiwan 2026国际半导体展将于2026年9月2日至9月4日在中国台北举行。聚焦于AI 晶片、先进制程、先进封装（如CoWoS）、矽光子（CPO）及高频宽记忆体（HBM）等前沿技术。预计吸引来自65 个国家、超过10 万名半导体专业人士，并汇聚1,300 家以上参展商与200 多位产业巨头。"}, {"id": 15047, "public_date": 1788321720, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "燧原科技IPO网上网下申购日", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 2, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 【燧原科技：初步询价日为8月28日，网上网下申购日为9月2日】 燧原科技公告，本次发行初始战略配售发行数量为860.7034万股，约占本次发行数量的20.00%，最终战略配售数量与初始战略配售数量的差额将根据“六、本次发行回拨机制”的原则进行回拨。回拨机制启动前，网下初始发行数量为2,754.2639万股，约占扣除初始战略配售数量后发行数量的80.00%，网上初始发行数量为688.5500万股，约占扣除初始战略配售数量后发行数量的20.00%。最终网下、网上发行合计数量为本次发行总数量扣除最终战略配售数量，网上及网下最终发行数量将根据回拨情况确定。初步询价日为8月28日，网上网下申购日为9月2日。"}, {"id": 1589152, "public_date": 1788346800, "observation_date": "2026-08-28", "wscn_ticker": "US191237", "country": "美国", "title": "8月28日当周MBA抵押贷款申请活动指数周环比", "event": "MBA抵押贷款申请活动指数周环比", "country_id": "US", "quantity": "", "unit": "%", "importance": 1, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg", "calendar_key": "63aa6888e93545def8fae9edfe4d0be2", "actual": "0.8", "forecast": "", "previous": "-1", "revised": "", "period": "周", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/US191237/overview", "assets": "fx,bd,stk@us", "foresight": ""}, {"id": 1589153, "public_date": 1788351300, "observation_date": "2026-08-01", "wscn_ticker": "US121065", "country": "美国", "title": "8月ADP就业人数变动(万人)", "event": "ADP就业人数变动", "country_id": "US", "quantity": "k", "unit": "万人", "importance": 3, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg", "calendar_key": "5c1c4b913be8ab2d66eee085493de3bb", "actual": "3.8", "forecast": "4.7", "previous": "4.4", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/US121065/overview", "assets": "cmd,fx,bd,stk@us", "foresight": ""}, {"id": 14986, "public_date": 1788356700, "observation_date": "", "wscn_ticker": "", "country": "加拿大", "title": "加拿大央行公布利率决议", "event": "", "country_id": "CA", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "ht