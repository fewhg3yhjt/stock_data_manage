l": "52.1", "forecast": "", "previous": "50.8", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/CN151370/overview", "assets": "cmd,fx,bd,stk@cn,stk@hk", "foresight": ""}, {"id": 15048, "public_date": 1788400800, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "阿里云容器服务Agent将开启商业化收费", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 2, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 8月4日，阿里云宣布，容器服务Agent将于北京时间9月3日10时增加新的技能中心和IM频道等功能并开启商业化收费。本次调整后，相关对话、自主智能运维及定时任务等功能将开始收费。调整过程不会影响存量用户已有设置和历史任务记录。容器服务Agent以积分（Credit）作为计量单位，免费开通，支持按量付费及预付费资源包抵扣。使用容器服务Agent的对话、自主智能运维及定时任务等功能时产生的模型资源消耗会折算为积分进行计费。"}, {"id": 1589174, "public_date": 1788401100, "observation_date": "2026-08-01", "wscn_ticker": "VN101003", "country": "越南", "title": "8月贸易余额(亿美元)", "event": "贸易余额", "country_id": "VN", "quantity": "m", "unit": "亿美元", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/37e702ac-2cf4-4abd-8792-2b402c42e89b.jpg", "calendar_key": "bbca724c942228a83e2f87ecc1228886", "actual": "-1.13", "forecast": "", "previous": "-35.87", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/VN101003/overview", "assets": "", "foresight": ""}, {"id": 1589173, "public_date": 1788401100, "observation_date": "2026-08-01", "wscn_ticker": "VN101002", "country": "越南", "title": "8月进口同比", "event": "进口同比", "country_id": "VN", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/37e702ac-2cf4-4abd-8792-2b402c42e89b.jpg", "calendar_key": "55c2eebbd207d77f9c9202eda260500a", "actual": "37.9", "forecast": "", "previous": "41.4", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/VN101002/overview", "assets": "", "foresight": ""}, {"id": 1589172, "public_date": 1788401100, "observation_date": "2026-08-01", "wscn_ticker": "VN101001", "country": "越南", "title": "8月出口同比", "event": "出口同比", "country_id": "VN", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/37e702ac-2cf4-4abd-8792-2b402c42e89b.jpg", "calendar_key": "09173ab11633b471066a41abcc729f95", "actual": "26", "forecast": "", "previous": "25", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/VN101001/overview", "assets": "", "foresight": ""}, {"id": 15045, "public_date": 1788408120, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "2026第五届低空经济发展大会", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 2, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 2026第五届低空经济发展大会将于9月3日至5日在芜湖举办以“共创低空新生态，打造发展新支柱”为主题。"}, {"id": 15015, "public_date": 1788408120, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "信诺维科创板 IPO 申购", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 2, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 信诺维将于9月3日进行网上网下申购，拟募资约31亿元。据公司招股意向书，公司为创新药企业，已形成\"1个NDA+3个III期+N\"管线梯队。新股延续科创板扩容节奏，关注创新药打新情绪。"}, {"id": 14993, "public_date": 1788408120, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "习近平将出席2026年上海合作组织峰会并对吉尔吉斯斯坦、埃及进行国事访问", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 3, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 据新华社，外交部发言人宣布：8月30日至9月3日，国家主席习近平将出席在比什凯克举行的2026年上海合作组织峰会，并应吉尔吉斯斯坦总统扎帕罗夫、埃及总统塞西邀请对两国进行国事访问。"}, {"id": 14989, "public_date": 1788408120, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "2026世界动力电池大会9/3-9/4日举行", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 4, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 2026世界动力电池大会将于9月3日至4日在四川省宜宾市举办。这是全国唯一、极具世界影响力的动力电池国际性会议。特斯拉、宁德时代、比亚迪等120余家中外龙头企业将齐聚，并发布《动力电池产业发展指数（2026）》等权威成果。\n期间还将举办“全球先进电池前瞻技术专题会议”，这是大会唯一的技术专题会议，议程将重点讨论全固态电池、AI驱动电池研发、以及针对低空及具身场景的高比能电池技术等前沿议题。"}, {"id": 14977, "public_date": 1788408120, "observation_date": "", "wscn_ticker": "", "country": "美国", "title": "特斯拉官宣：9月3日举行Cybercab发布会", "event": "", "country_id": "US", "quantity": "", "unit": "", "importance": 4, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 特斯拉将于当地时间9月3日在奥斯汀发布无方向盘、无踏板的无人驾驶车型Cybercab。此前报道称该车已完成道路测试和员工试乘，计划先向员工、后对公众开放。目前奥斯汀Robotaxi以186辆改装Model Y为主，Cybercab将逐步加入，但年内量产有限，商业化许可尚待明确。"}, {"id": 1589176, "public_date": 1788411600, "observation_date": "2026-08-01", "wscn_ticker": "IN193651", "country": "印度", "title": "8月服务业PMI终值", "event": "服务业PMI", "country_id": "IN", "quantity": "", "unit": "", "importance": 1, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/64bbee66-750e-43a5-ba25-ea15b5d1969b.jpg", "calendar_key": "314a2d9740aed4fd2fc5b82e60c370a8", "actual": "54.1", "forecast": "", "previous": "54.5", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/IN193651/overview", "assets": "", "foresight": ""}, {"id": 1589175, "public_date": 1788411600, "observation_date": "2026-08-01", "wscn_ticker": "IN193650", "country": "印度", "title": "8月综合PMI终值", "event": "综合PMI", "country_id": "IN", "quantity": "", "unit": "", "importance": 1, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/64bbee66-750e-43a5-ba25-ea15b5d1969b.jpg", "calendar_key": "21f1ffc40aa2e862807e6e6af89d80f5", "actual": "54.3", "forecast": "", "previous": "54.6", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/IN193650/overview", "assets": "", "foresight": ""}, {"id": 1589178, "public_date": 1788417000, "observation_date": "2026-08-01", "wscn_ticker": "CH112630", "country": "瑞士", "title": "8月CPI环比", "event": "CPI环比", "country_id": "CH", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/0db50726-9a41-4f9d-a489-da20f747f72f.jpg", "calendar_key": "5b36d7b06c6ce61f8409b732d559f677", "actual": "0.4", "forecast": "", "previous": "-0.1", "revised": "", "period": "月", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/CH112630/overview", "assets": "fx", "foresight": ""}, {"id": 1589177, "public_date": 1788417000, "observation_date": "2