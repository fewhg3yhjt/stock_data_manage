_key": "7981a70b571ea8dc060af001a5797770", "actual": "0.1", "forecast": "", "previous": "0.1", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/EA121983/overview", "assets": "fx,bd", "foresight": ""}, {"id": 1590778, "public_date": 1788771600, "observation_date": "2026-04-01", "wscn_ticker": "EA101916", "country": "欧元区", "title": "二季度GDP同比终值", "event": "GDP同比", "country_id": "EA", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/36e5a3fc-e45d-4a66-ae52-240d231779d9.jpg", "calendar_key": "6f138b862c5657ea9102600a8fed3c16", "actual": "1.2", "forecast": "1", "previous": "1", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/EA101916/overview", "assets": "cmd,fx,bd", "foresight": ""}, {"id": 1590777, "public_date": 1788771600, "observation_date": "2026-04-01", "wscn_ticker": "EA101917", "country": "欧元区", "title": "二季度GDP季环比终值", "event": "GDP季环比", "country_id": "EA", "quantity": "", "unit": "%", "importance": 2, "mark": "BB", "push_status": true, "flag_uri": "https://wpimg-wscn.awtmt.com/36e5a3fc-e45d-4a66-ae52-240d231779d9.jpg", "calendar_key": "66288d2991ed217ce7674479bc190e86", "actual": "0.6", "forecast": "0.4", "previous": "0.4", "revised": "", "period": "季", "calendar_type": "FD", "subscribe_status": false, "uri": "https://wallstreetcn.com/calendar/EA101917/overview", "assets": "cmd,fx,bd", "foresight": ""}, {"id": 15057, "public_date": 1788778800, "observation_date": "", "wscn_ticker": "", "country": "中国", "title": "小米秋季新品发布会：小米18 Fold等发布、小米澎程上市", "event": "", "country_id": "CN", "quantity": "", "unit": "", "importance": 4, "mark": "", "push_status": false, "flag_uri": "https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg", "calendar_key": "", "actual": "", "forecast": "", "previous": "", "revised": "", "period": "", "calendar_type": "FE", "subscribe_status": false, "uri": "", "assets": "", "foresight": "前瞻 | 9月2日，小米创办人，董事长兼CEO雷军在微博表示，小米秋季旗舰新品发布会定档9月7日晚7点，小米澎程N70 Pro/N70 Max/N90 Max正式上市。同场发布的，还有两款旗舰新品：小米18 Fold全新折叠屏旗舰手机和小米平板9Pro Max，首发玄戒O3 AI旗舰处理器。"}]}}