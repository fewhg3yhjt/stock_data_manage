e_status":false,"uri":"https://wallstreetcn.com/calendar/JP111723/overview","assets":"fx,bd","foresight":""},{"id":15214,"public_date":1789696800,"observation_date":"","wscn_ticker":"","country":"中国","title":"国新办将举行新闻发布会 介绍“十五五”时期推进住房城乡建设事业高质量发展有关情况","event":"","country_id":"CN","quantity":"","unit":"","importance":2,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/cef1c0c9-42b2-420a-b2f0-661a89ba8876.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 |  国务院新闻办公室将于2026年9月18日（星期五）上午10时举行“开局起步‘十五五’”系列主题新闻发布会，请住房和城乡建设部新闻发言人、副部长陈绍旺介绍“十五五”时期推进住房城乡建设事业高质量发展有关情况，并答记者问。"},{"id":15172,"public_date":1789704120,"observation_date":"","wscn_ticker":"","country":"美国","title":"布宜诺斯艾利斯谷物交易所作物报告","event":"","country_id":"US","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15171,"public_date":1789704120,"observation_date":"","wscn_ticker":"","country":"美国","title":"美棉On-Call周报","event":"","country_id":"US","quantity":"","unit":"","importance":1,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":""},{"id":15143,"public_date":1789704120,"observation_date":"","wscn_ticker":"","country":"美国","title":"韩美拟签8座大型核反应堆合作谅解备忘录","event":"","country_id":"US","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/d2ee5d16-9b68-4204-bfd4-b57bd2c16f2c.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 韩美拟签8座大型核反应堆合作 MOU，最早9月18日前后、涉资约120–130亿美元（据韩经日/ZeroHedge）。"},{"id":15071,"public_date":1789704120,"observation_date":"","wscn_ticker":"","country":"欧元区","title":"欧盟财长会议","event":"","country_id":"EA","quantity":"","unit":"","importance":3,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/36e5a3fc-e45d-4a66-ae52-240d231779d9.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 9月18日至19日在都柏林举行欧盟财长会议。会议议程可能包括，欧盟六国要求对石油公司征税。\n\n 记者获悉，德国、西班牙、葡萄牙、意大利、波兰和奥地利6个欧盟成员国财政部长日前联名致信欧盟轮值主席国爱尔兰，呼吁欧盟成员国在9月举行的欧盟财长会议上讨论一项机制，对因霍尔木兹海峡封锁、能源供应冲击而获得“暴利”的石油公司征税。（央视新闻）"},{"id":15016,"public_date":1789704120,"observation_date":"","wscn_ticker":"","country":"日本","title":"日本央行9月议息会议","event":"","country_id":"JP","quantity":"","unit":"","importance":4,"mark":"","push_status":false,"flag_uri":"https://wpimg-wscn.awtmt.com/9c75dc68-fcc8-42e2-8146-b8d53152e6e7.jpg","calendar_key":"","actual":"","forecast":"","previous":"","revised":"","period":"","calendar_type":"FE","subscribe_status":false,"uri":"","assets":"","foresight":"前瞻 | 日本央行将于9月18日（周五）公布利率决议，行长植田和男举行会后新闻发布会。彭博预计其将加息25个基点至1.25%，加息已被广泛定价。主要看点在于未来加息节奏的信号。"},{"id":1591976,"public_date":1789711200,"observation_date":"2026-08-01","wscn_ticker":"UK171654","country":"英国","title":"8月核心零售销售同比","event":"核心零售销售同比","country_id":"UK","quantity":"","unit":"%","importance":2,"mark":"BB","push_status":true,"flag_uri":"https://wpimg-wscn.awtmt.com/3969b3d1-8eea-492e-8190-c4a9a710878d.jpg","calendar_key":"e70b6959162dfcfc3f6903d1d65710d2","actual":"2.7","forecast":"1.9","previous":"2.3","revised":"","period":"月","calendar_type":"FD","subscribe_status":false,"uri":"https://wallstreetcn.com/calendar/UK171654/overview","assets":"fx","foresight":""},{"id":1591975,"public_date":1789711200,"observation_date":"2026-08-01