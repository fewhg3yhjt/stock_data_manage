<div class="weekbox">
    <div class="week"><a class="page nolink" href="javascript:void(0)" id="weekUp">&lt;&lt;上一周</a></div>
    <div class="line">|</div>
    <div class="week"><a class="page nolink js-day" href="javascript:void(0)" dt="--" onclick="selectWeek(this)">--</a></div>
    <div class="line">|</div>
    <div class="week"><a class="page nolink js-day" href="javascript:void(0)" dt="--" onclick="selectWeek(this)">--</a></div>
