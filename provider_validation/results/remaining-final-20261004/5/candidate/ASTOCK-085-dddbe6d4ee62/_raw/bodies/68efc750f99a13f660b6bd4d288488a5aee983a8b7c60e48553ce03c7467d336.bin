<script>
    jQuery.noConflict();
    function checkSearch(form)
    {
        var pattern = /^(sh|sz)?[0-9]{6}$/;
        var rs = pattern.test(form.symbol.value);
        if(rs == false){
            alert('不正确的股票代码');
            //form.symbol.value = '证券简称或代码';
            return false;
        }
        return true;
    }
</script>
