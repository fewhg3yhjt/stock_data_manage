    <div class="week"><a class="page nolink js-day" href="javascript:void(0)" dt="--" onclick="selectWeek(this)">--</a></div>
    <div class="line">|</div>
    <div class="week"><a class="page nolink js-day" href="javascript:void(0)" dt="--" onclick="selectWeek(this)">--</a></div>
    <div class="line">|</div>
    <div class="week"><a class="page nolink" href="javascript:void(0);" id="weekDown">下一周&gt;&gt;</a></div>
</div>
<script type="text/javascript">
    var StandardBJTime = 1790697600;
    function selectWeek(obj)
    {
        parent.location = '?tradedate='+jQuery(obj).attr('dt');
    }
    !function ($)
    {
        var weekday = new function ()
        {
            var _days,_up,_down,_offset = 0;
            var _dayToCN = ['日','一','二','三','四','五','六'];
            function _draw()
            {
                var _now = StandardBJTime * 1000 + 1000 * 60 * 60 * 24 * _offset * 7;
                var _today = new Date(_now);
                var _dayToday = _today.getDay();
                if(_dayToday == 0)
                {
                    _dayToday = -1;
                }
                else
                {
                    _dayToday -= 1;
                }
                var _start = _now - 1000 * 60 * 60 * 24 * _dayToday;
                var _day;
                for(var i = 0;i < 5;i++)
                {
                    _day = new Date(_start + 1000 * 60 * 60 * 24 * i);
                    _days.eq(i).attr('dt',_day.getFullYear() + '-' + formatDT(_day.getMonth() + 1) + '-' + formatDT(_day.getDate()));
                    if(_days.eq(i).attr('dt') == '2026-09-30')
                        _days.eq(i).css('color','#FF0000');
                    else
                        _days.eq(i).css('color','#000000');
                    _days.eq(i).html(_day.getMonth() + 1 + '月' + _day.getDate() + '日(周' + _dayToCN[_day.getDay()] + ')');
                }
            }
            function formatDT(dt)
            {
                return dt < 10 ? '0' + dt : dt;
            }
            function _goUp()
            {
                _offset -= 1;
                _draw();
            }
            function _goDown()
            {
                _offset += 1;
                _draw();
            }
            this.init = function ()
            {
                _days = $('a.js-day');
                _up = $('#weekUp');
                _up.click(_goUp);
                _down = $('#weekDown');
                _down.click(_goDown);
                _draw();
            };
        } ();
        $(function ()
        {
            setInterval(function () { StandardBJTime += 1; },1000);
            weekday.init();
        });
    } (jQuery);
</script>            <div class="page_config">
                <div class="right"></div>
            </div>
            <!--e-->
            <script type="text/javascript" src="http://vip.stock.finance.sina.com.cn/q/view/js/followme.js"></script>
            <script type="text/javascript">
            /*代替$.getScript*/
            function getScript(argUrl,argCallback,argCharset)
            {
                var _script = document.createElement('script');
                _script.type = 'text/javascript';
                if(argCharset)
                {
                    _script.charset = argCharset;
                }
                _script.src = argUrl;
                var _head = document.getElementsByTagName('head')[0];
                var _done = false;
                _script.onload = _script.onreadystatechange = function ()
                {
                    if(!_done && (!this.readyState || this.readyState === "loaded" || this.readyState === "complete"))
                    {
                        _done = true;
                        if(argCallback)
                        {
                            argCallback();
                        }
                        _script.onload = _script.onreadystatechange = null;
                        setTimeout(function ()
                        {
                            _head.removeChild(_script);
                        },1);
                    }
                };
                _head.appendChild(_script);
            }
            var gotDetailsID = '';

            function showDetail(type,code,tradedate,obj)
            {
                if(gotDetailsID.indexOf('|' + type + '_' + code + '|') == -1)
                {
                    getScript('http://vip.stock.finance.sina.com.cn/q/api/jsonp.php/var%20details=/InvestConsultService.getLHBComBSData?symbol=' + code + '&tradedate=' + tradedate + '&type=' + type,function ()
                    {
                        var $ = jQuery;

                        //买入的
                        var _tbody = $('#stock' + type + '_' + code + '_b').find('tbody');
                        var _tr,_td,_a;
                        var _single;
                        for(var i = 0;i < details.buy.length;i++)
                        {
                            _single = details.buy[i];
                            _tr = $('<tr>').appendTo(_tbody);

                            if(!isNaN(_single.comCode) && _single.comName != '机构专用')
                            {
                                _td = $('<td>').appendTo(_tr);
                                _a = $('<a>').attr('target','_blank').attr('href','http://vip.stock.finance.sina.com.cn/q/go.php/vInvestConsult/kind/lhb/index.phtml?comcode=' + _single.comCode).html(_single.comName).appendTo(_td);
                            }
                            else
                            {
                                _td = $('<td>').html(_single.comName).appendTo(_tr);
                              
                            }
                            _td = $('<td>').html(_single.buyAmount).appendTo(_tr);
                            _td = $('<td>').html(_single.sellAmount).appendTo(_tr);
                            _td = $('<td>').html(_single.netAmount).appendTo(_tr);
                        }

                        //卖出的
                        var _tbody = $('#stock' + type + '_' + code + '_s').find('tbody');
                        var _tr,_td,_a;
                        var _single;
                        for(var i = 0;i < details.buy.length;i++)
                        {
                            _single = details.sell[i];
                            _tr = $('<tr>').appendTo(_tbody);

                            if(!isNaN(_single.comCode) && _single.comName != '机构专用')
                            {
                                _td = $('<td>').appendTo(_tr);
                                _a = $('<a>').attr('target','_blank').attr('href','http://vip.stock.finance.sina.com.cn/q/go.php/vInvestConsult/kind/lhb/index.phtml?comcode=' + _single.comCode).html(_single.comName).appendTo(_td);
                            }
                            else
                            {
                                _td = $('<td>').html(_single.comName).appendTo(_tr);

                            }
                            _td = $('<td>').html(_single.buyAmount).appendTo(_tr);
                            _td = $('<td>').html(_single.sellAmount).appendTo(_tr);
                            _td = $('<td>').html(_single.netAmount).appendTo(_tr);
                        }
                    });
                    gotDetailsID += '|' + type + '_' + code + '|';
                }
                var id = 'stock' + type + '_' + code;
                var ele = jQuery('#'+id);

                if(ele.css('display') == 'none')
                {
                    jQuery(obj).text('关闭交易详情')
                    ele.show();
                }else{
                    jQuery(obj).text('查看交易详情')
                    ele.hide();
                }
                return false;
            }

            </script>
