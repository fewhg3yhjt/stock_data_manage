dataset:
  name: intraday_changes
  display_name: 东财日内异动池（明细接口）候选输入
  primary_key:
  - snapshot_at
  - source_row_number
fields:
  snapshot_at:
    type: datetime
    required: true
  source_row_number:
    type: integer
    required: true
  source_security_code:
    type: string
    required: false
  event_time:
    type: string
    required: false
  name:
    type: string
    required: false
  event_type:
    type: string
    required: false
  source_type:
    type: string
    required: false
  source_details:
    type: string
    required: false
