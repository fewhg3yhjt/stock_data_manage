_nick": "", "parent_profile_img": "", "area": "香港", "status_uid": "0", "comment_imgs": null, "status_cmnt_mid": "", "import_type": "", "media_type": "0", "audio": "", "video": "", "openid": "", "login_type": "0", "batch_type": "", "check_type": "2", "status_show": "1", "code": "4000", "layer": "1", "show_loc": "1", "top_desc": "", "thread2": "", "status2": "M_PASS", "content_ext": {"reply": 0, "weibourl": "", "videoinfo": ""}, "is_hot": "0", "is_top": "0", "parent_new": "", "count_layer": "0", "did": "", "is_agree": "0", "has_my": "", "has_link": "0"}], "total": 4, "thread_show": 1, "qreply": 0, "qreply_show": 0, "show": 1}, "docurl": "https://finance.sina.cn/7x24/2026-10-03/detail-initxwvz0622244.d.html", "rich_text_nick_to_url": [], "rich_text_nick_to_routeUri": [], "compere_info": ""}, {"id": 5124883, "zhibo_id": 152, "type": 0, "rich_text": "【日本在八丈岛附近海域找到8名失联的潜水者】日本共同社3日报道，日本海上保安部门当天在日本八丈岛附近海域救起8名早些时候失联的潜水者。（新华社）", "multimedia": "", "commentid": "live:finance-152-5124883:0", "compere_id": 0, "creator": "yujian@staff.sina.com.cn", "mender": "yujian@staff.sina.com.cn", "create_time": "2026-10-03 16:44:57", "update_time": "2026-10-03 16:45:24", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "0", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\/\\/finance.sina.com.cn\\/7x24\\/2026-10-03\\/doc-initxwvz0620229.shtml\",\"docid\":\"nitxwvz0620229\"}", "old_live_cid": "0", "tab": "", "is_repeat": "0", "tag": [{"id": "102", "name": "国际"}], "like_nums": 0, "comment_list": {"list": [], "total": 0, "thread_show": 0, "qreply": 0, "qreply_show": 0, "show": 0}, "docurl": "https://finance.sina.cn/7x24/2026-10-03/detail-initxwvz0620229.d.html", "rich_text_nick_to_url": [], "rich_text_nick_to_routeUri": [], "compere_info": ""}, {"id": 5124882, "zhibo_id": 152, "type": 0, "rich_text": "阿联酋总统顾问加尔加什在X平台上表示，最新的“恐怖”袭击再次发出警告：该地区打击极端主义的斗争尚未结束。", "multimedia": "", "commentid": "live:finance-152-5124882:0", "compere_id": 0, "creator": "yujian@staff.sina.com.cn", "mender": "yujian@staff.sina.com.cn", "create_time": "2026-10-03 16:44:47", "update_time": "2026-10-03 16:44:47", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "0", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\/\\/finance.sina.com.cn\\/7x24\\/2026-10-03\\/doc-initxwvz0620160.shtml\",\"docid\":\"nitxwvz0620160\"}", "old_live_cid": "0", "tab": "", "is_repeat": "0", "tag": [{"id": "8", "name": "其他"}], "like_nums": 0, "comment_list": {"list": [], "total": 0, "thread_show": 0, "qreply": 0, "qreply_show": 0, "show": 0}, "docurl": "https://finance.sina.cn/7x24/2026-10-03/detail-initxwvz0620160.d.html", "rich_text_nick_to_url": [], "rich_text_nick_to_routeUri": [], "compere_info": ""}, {"id": 5124881, "zhibo_id": 152, "type": 0, "rich_text": "【巴基斯坦外交部就两名巴平民被杀事件传召印度临时代办】10月3日，巴基斯坦外交部发表声明称，巴基斯坦外交部已经传召印度临时代办，就印度边境安全部队人员于2026年10月2日在印巴边境开枪打死两名巴基斯坦平民一事，向印方提出强烈抗议。声明称，印方边境安全部队人员对平民使用了无端的致命武力。这种使用武力的行为完全没有正当理由。巴基斯坦明确拒绝任何试图将死者描述为“渗透者”的做法。巴方要求印度方面立即对这一事件展开透明、可信的调查，对查明负有责任的人员采取适当的纪律和法律行动，并正式向巴基斯坦政府通报调查结果及所采取的措施。巴方还敦促印度确保尊重基本人权和国际法，严格遵守有关双边安排和既定边境程序，在处理此类情况时保持最大限度的克制，并采取有效措施，防止类似事件再次发生。", "multimedia": "", "commentid": "live:finance-152-5124881:0", "compere_id": 0, "creator": "yujian@staff.sina.com.cn", "mender": "lingchen1@staff.sina.com.cn", "create_time": "2026-10-03 16:43:25", "update_time": "2026-10-03 16:44:49", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "20261003164449", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":