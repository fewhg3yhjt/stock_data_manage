eate_time": "2026-10-03 17:18:22", "update_time": "2026-10-03 17:18:22", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "0", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\/\\/finance.sina.com.cn\\/7x24\\/2026-10-03\\/doc-initxwvz0640022.shtml\",\"docid\":\"nitxwvz0640022\"}", "old_live_cid": "0", "tab": "", "is_repeat": "0", "tag": [{"id": "102", "name": "国际"}], "like_nums": 0, "comment_list": {"list": [], "total": 0, "thread_show": 0, "qreply": 0, "qreply_show": 0, "show": 0}, "docurl": "https://finance.sina.cn/7x24/2026-10-03/detail-initxwvz0640022.d.html", "rich_text_nick_to_url": [], "rich_text_nick_to_routeUri": [], "compere_info": ""}, {"id": 5124890, "zhibo_id": 152, "type": 0, "rich_text": "【消息称美俄关于乌克兰问题的会谈包含石油交易】据知情人士透露，俄罗斯总统普京在与美国特使会面时，提出了涉及出售俄罗斯能源资产的潜在商业交易。美俄双方还探讨了通过战后美俄能源合作等经济举措来推动双边关系“重启”的可能性。知情人士称，普京在会面中主动提议，推动出售俄罗斯最大私营能源巨头之一——卢克石油公司（Lukoil）旗下的庞大资产包。这其中包括该公司分布在全球各地的油田、炼油厂以及加油站（如非洲喀麦隆的油田、欧洲的炼油厂以及美国新泽西州的加油站等）。目前正在争取这笔交易的财团包括：美国亿万富豪、洛杉矶道奇队共同所有者托德·伯利（Todd Boehly）（他曾向特朗普的政治筹款组织捐赠了巨资）；两个与库什纳或威特科夫家族有深度商业合作的中东财团（包括阿联酋和卡塔尔的皇室及主权相关背景基金）；美国政府本身（计划通过美国国际发展金融公司直接参股该新企业）。", "multimedia": "", "commentid": "live:finance-152-5124890:0", "compere_id": 0, "creator": "yujian@staff.sina.com.cn", "mender": "yujian@staff.sina.com.cn", "create_time": "2026-10-03 17:17:52", "update_time": "2026-10-03 17:18:50", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "0", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":[{\"market\":\"global\",\"symbol\":\"hf_cl\",\"key\":\"\\u77f3\\u6cb9\",\"hot\":3804},{\"market\":\"global\",\"symbol\":\"hf_oil\",\"key\":\"\\u77f3\\u6cb9\",\"hot\":1998},{\"market\":\"commodity\",\"symbol\":\"nf_sc0\",\"key\":\"\\u77f3\\u6cb9\",\"hot\":291},{\"market\":\"us\",\"symbol\":\"lukoy\",\"key\":\"\\u5362\\u514b\\u77f3\\u6cb9\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\/\\/finance.sina.com.cn\\/7x24\\/2026-10-03\\/doc-initxwvx3867301.shtml\",\"docid\":\"nitxwvx3867301\"}", "old_live_cid": "0", "tab": "", "is_repeat": "0", "tag": [{"id": "3", "name": "公司"}, {"id": "102", "name": "国际"}], "like_nums": 0, "comment_list": {"list": [{"mid": "6AC0CB5F-2790A86B-1DCA2CFF7-7FF-87E", "comment_mid": "0", "channel": "live", "newsid": "finance-152-5124890", "news_mid": "0", "channel_source": "", "newsid_source": "", "news_mid_source": "0", "status": "M_PASS", "time": "2026-10-03 17:31:11", "agree": "0", "score": "5", "hot": "0", "against": "1791019871", "length": "43", "rank": "0", "vote": "0", "level": "0", "parent": "6AC0CA7A-790EC042-1BB53842F-7FF-8A5", "parent_mid": "0", "thread": "6AC0CA7A-790EC042-1BB53842F-7FF-8A5", "thread_mid": "0", "uid": "7996624887", "nick": "用户7996624887", "usertype": "financeapp", "content": "跟和平有啥关系，卖乌克兰武器，收购俄罗斯能源，这意思是两边钱都要赚，你们接着打[哈哈]", "ip": "", "config": "wb_verified=0&wb_screen_name=用户7996624887&area=江西九江&wb_user_id=7996624887&withMobile=&followers_count=1&wb_description=&client_port=49756&cjguba_id=2&wb_profile_img=http://n.sinaimg.cn/sinanews/eb9bf575/20190108/TouXiang120.png&wb_verified_type=&wb_time=1791019871&city_code=CN36040000000000&p_nick=中人寿辉哥&p_uid=7437780015&parent_new=6AC0CA7A-790EC042-1BB53842F-7FF-8A5&layer=2&show_loc=1", "profile_img": "http://n.sinaimg.cn/sinanews/eb9bf575/20190108/TouXiang120.png", "parent_uid": "7437780015", "parent_nick": "中人寿辉哥", "parent_profile_img": "https://tvax3.sinaimg.cn/crop.37.0.225.225.50/0087malNly8gw7m1wwnh8j308c069wei.jpg", "area": "江西九江", "status_uid": "0", "comment_imgs": null, "status_cmnt_mid": "", "import_type": "", "media_type": "0", "audio": "", "video": "", "openid": "", "login_type": "0", "batch_type": "", "check_type": "2", "stat