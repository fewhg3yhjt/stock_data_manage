2026-10-03 17:03:49", "update_time": "2026-10-03 17:03:49", "is_need_check": "0", "check_time": "1970-01-01 08:00:01", "check_status": "1", "check_user": "", "is_delete": 0, "top_value": 0, "is_focus": 0, "source_content_id": "0", "anchor_image_url": "", "anchor": "", "ext": "{\"stocks\":[{\"market\":\"cn\",\"symbol\":\"si000979\",\"key\":\"\\u5927\\u5b97\\u5546\\u54c1\",\"hot\":442},{\"market\":\"fund\",\"symbol\":\"012724\",\"key\":\"\\u5927\\u5b97\\u5546\\u54c1\",\"sym_party_status\":\"0\",\"hot\":38},{\"market\":\"fund\",\"symbol\":\"005106\",\"key\":\"\\u5927\\u5b97\\u5546\\u54c1\",\"sym_party_status\":\"0\",\"hot\":4},{\"market\":\"fund\",\"symbol\":\"510300\",\"key\":\"\\u6d41\\u52a8\\u6027\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\/\\/finance.sina.com.cn\\/7x24\\/2026-10-03\\/doc-initxwvz0631148.shtml\",\"docid\":\"nitxwvz0631148\"}", "old_live_cid": "0", "tab": "", "is_repeat": "0", "tag": [{"id": "102", "name": "国际"}], "like_nums": 0, "comment_list": {"list": [], "total": 0, "thread_show": 0, "qreply": 0, "qreply_show": 0, "show": 0}, "docurl": "https://finance.sina.cn/7x24/2026-10-03/detail-initxwvz0631148.d.html", "rich_text_nick_to_url": [], "rich_text_nick_to_routeUri": [], "compere_info": ""}, {"id": 5124884, "zhibo_id": 152, "type": 0, "rich_text": "【教育部部署开展2027届高校毕业生校园招聘月活动】记者近日从教育部获悉，为促进2027届高校毕业生顺利就业、尽早就业，“金秋启航”校园招聘月系列活动于2026年9月至11月集中开展。 招聘月期间，各地将充分发挥校园招聘主渠道作用，深入实施“万企进校园”计划，邀请民营企业、中小微企业进校宣讲招聘，办好“小而精、专而优”的院系专场招聘，分区域分行业开展“千校万企”“千行万业”供需对接。同时，指导就业资源薄弱高校制定访企拓岗方案，面向专精特新企业、行业龙头企业等定向拓岗，对接人工智能、数字经济等新兴产业，挖掘就业新赛道。 对脱贫家庭、低保家庭、零就业家庭及残疾人等重点群体毕业生，将“一人一档”建立帮扶台账，落实“一对一”结对帮扶，优先推荐岗位、优先指导培训、优先安排实习，原则上每人至少推荐3个有效岗位。（新华社）", "multimedia": "", "commentid": "live:finance-152-5124884:0", "compere_id": 0, "creator": "yujian@staff.sina.com.cn", "mender": "yujian@staff.sina.com.cn", "create_time": "2026-10-03 16:48:38", "update_time": "2026-10-03 16:48:38", "is_need_check": "1", "check_time