ading_num": 948706, "content": "【冈本三成接任日本在野党公明党党首】财联社10月3日电，日本在野党公明党3日举行党大会，正式批准日本众议员冈本三成接替竹谷敏子担任党首。 （央视新闻）", "in_roll": 1, "recommend": 0, "confirmed": 0, "jpush": 0, "img": "", "user_id": 639, "is_top": 0, "brief": "【冈本三成接任日本在野党公明党党首】财联社10月3日电，日本在野党公明党3日举行党大会，正式批准日本众议员冈本三成接替竹谷敏子担任党首。", "id": 2497519, "ctime": 1791008758, "type": -1, "title": "冈本三成接任日本在野党公明党党首", "bold": 0, "sort_score": 1791008758, "comment_num": 0, "modified_time": 1791009392, "status": 1, "collection": 0, "has_img": 0, "category": "", "shareurl": "https://api3.cls.cn/share/article/2497519?os=web&sv=8.4.6&app=CailianpressWeb", "share_img": "https://img.cls.cn/share/roll.png", "share_num": 13, "sub_titles": [], "tags": [], "imgs": [], "images": [], "explain_num": -1, "stock_list": [], "is_ad": 0, "ad": {"id": 0, "title": "", "img": "", "url": "", "monitorUrl": "", "video_url": "", "adTag": "", "fullScreen": 0, "type": 0}, "subjects": [{"article_id": 2497519, "subject_id": 1556, "subject_name": "环球市场情报", "subject_img": "", "subject_description": "", "category_id": 0, "attention_num": 171030, "is_attention": false, "is_reporter_subject": false, "plate_id": 0, "channel": "cls"}], "audio_url": ["https://image.cls.cn/admin/20261003/143633u4d8aXm3pWns.mp3"], "author": "央视新闻", "plate_list": [], "assocArticleUrl": "", "assocVideoTitle": "", "assocVideoUrl": "", "assocCreditRating": [], "invest_calendar": {"id": 0, "data_id": 0, "r_id": "", "type": 0, "calendar_time": "", "setting_time": "", "event": null, "economic": null, "short_latents": null}, "share_content": "", "gray_share": 0, "comment_recommand": null, "timeline": null, "is_fad": 0, "disclaimer": ""}, {"author_extends": "", "assocFastFact": {"fid": 0, "fast_fact_content": "", "article_id": 0, "article_title": "", "imgs": "", "slogan": ""}, "depth_extends": "null", "deny_comment": 0, "level": "C", "reading_num": 1014979, "content": "【特朗普称对伊朗下一步行动“进展顺利”】财联社10月3日电，据美国方面2日报道，美国总统特朗普当天称，对伊朗的下一步行动“进展顺利”。当天被问及美国对伊朗的下一步行动时，特朗普回应称其“重大”，并称行动“进展得非常顺利”，“伊朗的情况不妙”。消息还称，美政府“核心内阁成员”当天在马里兰州总统度假地戴维营举行数小时的闭门会议，讨论伊朗战事及针对沙特阿拉伯同也门胡塞武装冲突的下一步行动。消息援引多名美官员的话称，此次会议“高度不寻常”，没有对外正式公布。上次举行类似会议是在2025年6月，即以色列对伊朗多地发动大规模空袭的前几日。谈及中东局势时，一名官员称：“有些事情已经作出决定，至少已进行了深入讨论。” （央视新闻）", "in_roll": 1, "recommend": 0, "confirmed": 0, "jpush": 0, "img": "", "user_id": 639, "is_top": 0, "brief": "【特朗普称对伊朗下一步行动“进展顺利”】财联社10月3日电，据美国方面2日报道，美国总统特朗普当天称，对伊朗的下一步行动“进展顺利”。当天被问及美国对伊朗的下一步行动时，特朗普回应称其“重大”，并称行动“进展得非常顺利”，“伊朗的情况不妙”。消息还称，美政府“核心内阁成员”当天在马里兰州总统度假地戴维营举行数小时的闭门会议，讨论伊朗战事及针对沙特阿拉伯同也门胡塞武装冲突的下一步行动。消息援引多名美官员的话称，此次会议“高度不寻常”，没有对外正式公布。上次举行类似会议是在2025年6月，即以色列对伊朗多地发动大规模空袭的前几日。谈及中东局势时，一名官员称：“有些事情已经作出决定，至少已进行了深入", "id": 2497518, "ctime": 1791008271, "type": -1, "title": "特朗普称对伊朗下一步行动“进展顺利”", "bold": 0, "sort_score": 1791008271, "comment_num": 4, "modified_time": 1791008271, "status": 1, "collection": 0, "has_img": 0, "category": "", "shareurl": "https://api3.cls.cn/share/article/2497518?os=web&sv=8.4.6&app=CailianpressWeb", "share_img": "https://img.cls.cn/share/roll.png", "share_num": 79, "sub_titles": [], "tags": [], "imgs": [], "images": [], "explain_num": -1, "stock_list": [], "is_ad": 0, "ad": {"id": 0, "title": "", "img": "", "url": "", "monitorUrl": "", "video_url": "", "adTag": "", "fullScreen": 0, "type": 0}, "subjects": [{"article_id": 2497518, "subject_id": 1556, "subject_name": "环球市场情报", "subject_img": "", "subject_description": "", "category_id": 0, "attention_num": 171030, "is_attention": false, "is_reporter_subject": false, "plate_id": 0, "channel": "cls"}], "audio_url": ["https://image.cls.cn/admin/20261003/141751ipZXCku1mCLw.mp3"], "author": "央视新闻", "plate_list": [], "assocArticleUrl": "", "assocVideoTitle": "", "assocVideoUrl": "", "assocCreditRating": [], "invest_calendar": {"id": 0, "data_id": 0, "r_id": "", "type": 0, "calendar_time": "", "setting_time": "", "event": null, "economic": null, "short_latents": null}, "share_content": "", "gray_share": 0, "comment_recommand": null, "timeline": null, "is_fad": 0, "disclaimer": ""}, {"author_extends": "", "assocFastFact": {"fid": 0, "fast_fact_content": "", "article_id": 0, "article_title": "", "imgs": "", "slogan": ""}, "depth_extends": "null", "deny_comment": 0, "level": "C", "reading_num": 1051517, "content": "【“21世纪海上丝绸之路”航线已覆盖全球100多个国家和地区】财联社10月3日电，今天（3日）是共同建设“21世纪海上丝绸之路”提出13周年。这条海上丝绸之路的建设，有力促进了我国与东南亚、非洲、拉美等地区国家经贸合作不断迈上新台阶。今年以来，我国新开通多条直达拉美、东南亚等地的外贸航线，国际集装箱班轮航线已覆盖全球100多个国家和地区。 （央视新闻）", "in_roll": 1, "recommend": 0, "confirmed": 0, "jpush": 0, "img": "", "user_id": 639, "is_top": 0, "brief": "【“21世纪海上丝绸之路”航线已覆盖全球100多个国家和地区】财联社10月3日电，今天（3日）是共同建设“21世纪海上丝绸之路”提出13周年。这条海上丝绸之路的建设，有力促进了我国与东南亚、非洲、拉美等地区国家经贸合作不断迈上新台阶。今年以来，我国新开通多条直达拉美、东南亚等地的外贸航线，国际集装箱班轮航线已覆盖全球100多个国家和地区。", "id": 2497515, "ctime": 1791007854, "type": -1, "title": "“21世纪海上丝绸之路”航线已覆盖全球100多个国家和地区", "bold": 0, "sort_score": 1791007854, "comment_num": 0, "modified_time": 1791007854, "status": 1, "collection": 0, "has_img": 0, "category": "", "shareurl": "https://api3.cls.cn/share/article/2497515?os=web&sv=8.4.6&app=CailianpressWeb", "share_img": "https://img.cls.cn/share/roll.png", "share_num": 23, "sub_titles": [], "tags": [], "imgs": [], "images": [], "explain_num": -1, "stock_list": [], "is_ad": 0, "ad": {"id": 0, "title": "", "img": "", "url": "", "monitorUrl": "", "video_url": "", "adTag": "", "fullScreen": 0, "type": 0}, "subjects": [], "audio_url": ["https://image.cls.cn/admin/20261003/141055sNVMtGaQXM8E.mp3"], "author": "央视新闻", "plate_list": [], "assocArticleUrl": "", "assocVideoTitle": "", "assocVideoUrl": "", "assocCreditRating": [], "invest_calendar": {"id": 0, "data_id": 0, "r_id": "", "type": 0, "calendar_time": "", "setting_time": "", "event": null, "economic": null, "short_latents": null}, "share_content": "", "gray_share": 0, "comment_recommand": null, "timeline": null, "is_fad": 0, "disclaimer": ""}], "is_vip": 0, "update_num": 0, "banners": null, "dynamic_tag": {"id": 0, "title": "", "category": ""}}}