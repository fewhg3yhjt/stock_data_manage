ent": "", "article_id": 0, "article_title": "", "imgs": "", "slogan": ""}, "depth_extends": "null", "deny_comment": 0, "level": "C", "reading_num": 709917, "content": "【交通运输部：10月2日全社会跨区域人员流动量30550.4万人次】财联社10月3日电，交通运输部数据显示，2026年10月2日（国庆假期第2日），全社会跨区域人员流动量30550.4万人次，环比下降7.3%，比2025年同期（10月2日，中秋国庆假期第2日，下同）增长1.2%。其中：铁路客运量2076.5万人次，环比下降17.6%，同比增长7.7%；公路人员流动量28052万人次，环比下降6.6%，同比增长0.8%（其中公路营业性客运量3882万人次，环比下降13.2%，同比增长5.1%；高速公路及普通国省道非营业性小客车人员出行量24170万人次，环比下降5.5%，同比增长0.1%）；水路客运量181.7万人次，环比增长28.3%，同比增长9.4%；民航客运量240.2万人次，环比下降4.5%，同比下降2.8%。", "in_roll": 1, "recommend": 0, "confirmed": 0, "jpush": 0, "img": "", "user_id": 183, "is_top": 0, "brief": "【交通运输部：10月2日全社会跨区域人员流动量30550.4万人次】财联社10月3日电，交通运输部数据显示，2026年10月2日（国庆假期第2日），全社会跨区域人员流动量30550.4万人次，环比下降7.3%，比2025年同期（10月2日，中秋国庆假期第2日，下同）增长1.2%。其中：铁路客运量2076.5万人次，环比下降17.6%，同比增长7.7%；公路人员流动量28052万人次，环比下降6.6%，同比增长0.8%（其中公路营业性客运量3882万人次，环比下降13.2%，同比增长5.1%；高速公路及普通国省道非营业性小客车人员出行量24170万人次，环比下降5.5%，同比增长0.1%）；水路", "id": 2497523, "ctime": 1791011047, "type": -1, "title": "交通运输部：10月2日全社会跨区域人员流动量30550.4万人次", "bold": 0, "sort_score": 1791011047, "comment_num": 0, "modified_time": 1791011047, "status": 1, "collection": 0, "has_img": 0, "category": "", "shareurl": "https://api3.cls.cn/share/article/2497523?os=web&sv=8.4.6&app=CailianpressWeb", "share_img": "https://img.cls.cn/share/roll.png", "share_num": 15, "sub_titles": [], "tags": [], "imgs": [], "images": [], "explain_num": -1, "stock_list": [], "is_ad": 0, "ad": {"id": 0, "title": "", "img": "", "url": "", "monitorUrl": "", "video_url": "", "adTag": "", "fullScreen": 0, "type": 0}, "subjects": [], "audio_url": ["https://image.cls.cn/admin/20261003/150407VH124zTpQkfu.mp3"], "author": "", "plate_list": [], "assocArticleUrl": "", "assocVideoTitle": "", "assocVideoUrl": "", "assocCreditRating": [], "invest_calendar": {"id": 0, "data_id": 0, "r_id": "", "type": 0, "calendar_time": "", "setting_time": "", "event": null, "economic": null, "short_latents": null}, "share_content": "", "gray_share": 0, "comme