th_extends": "null", "deny_comment": 0, "level": "C", "reading_num": 773061, "content": "【印媒称印边防人员在印巴边境打死两名疑似巴基斯坦人】财联社10月3日电，据《印度斯坦时报》3日报道，印度边境安全部队2日在印度北部旁遮普邦印巴边境附近开枪打死两名疑似巴基斯坦人。报道援引印官员的话称，印边境安全部队人员2日中午在旁遮普邦达尔恩达兰地区发现有人试图越过印巴边境进入印度。印方人员多次警告要求对方停下，但对方“无视并继续向印度一侧移动”，印方人员遂开枪射击，造成两人死亡。印方称两名死者疑似“巴方渗透人员”。报道说，两名死者身份尚未确认，遗体已移交当地警方进行尸检。 （新华社）", "in_roll": 1, "recommend": 0, "confirmed": 0, "jpush": 0, "img": "", "user_id": 639, "is_top": 0, "brief": "【印媒称印边防人员在印巴边境打死两名疑似巴基斯坦人】财联社10月3日电，据《印度斯坦时报》3日报道，印度边境安全部队2日在印度北部旁遮普邦印巴边境附近开枪打死两名疑似巴基斯坦人。报道援引印官员的话称，印边境安全部队人员2日中午在旁遮普邦达尔恩达兰地区发现有人试图越过印巴边境进入印度。印方人员多次警告要求对方停下，但对方“无视并继续向印度一侧移动”，印方人员遂开枪射击，造成两人死亡。印方称两名死者疑似“巴方渗透人员”。报道说，两名死者身份尚未确认，遗体已移交当地警方进行尸检。", "id": 2497521, "ctime": 1791010681, "type": -1, "title": "印媒称印边防人员在印巴边境打死两名疑似巴基斯坦人", "bold": 0, "sort_score": 1791010681, "comment_num": 0, "modified_time": 1791010681, "status": 1, "collection": 0, "has_img": 0, "category": "", "shareurl": "https://api3.cls.cn/share/article/2497521?os=web&sv=8.4.6&app=CailianpressWeb", "share_img": "https://img.cls.cn/share/roll.png", "share_num": 26, "sub_titles": [], "tags": [], "imgs": [], "images": [], "explain_num": -1, "stock_list": [], "is_ad": 0, "ad": {"id": 0, "title": "", "img": "", "url": "", "monitorUrl": "", "video_url": "", "adTag": "", "fullScreen": 0, "type": 0}, "subjects": [{"article_id": 2497521, "subject_id": 1556, "subject_name": "环球市场情报", "subject_img": "", "subject_description": "", "category_id": 0, "attention_num": 171030, "is_attention": false, "is_reporter_subject": false, "plate_id": 0, "channel": "cls"}], "audio_url": ["https://image.cls.cn/admin/20261003/145802IoHcaIScAGlk.mp3"], "author": "新华社", "plate_list": [], "assocArticleUrl": "", "assocVideoTitle": "", "assocVideoUrl": "", "assocCreditRating": [], "invest_calendar": {"id": 0, "data_id": 0, "r_id": "", "type": 0, "calendar_time": "", "setting_time": "", "event": null, "economic": null, "short_latents": null}, "share_content": "", "gray_share": 0, "comment_recommand": null