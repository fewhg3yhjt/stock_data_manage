76\u4ed6\u6295\u8d44\u8005\u7b49(\u56fd\u5bb6\u6cd5\u5f8b\u3001\u6cd5\u89c4\u7981\u6b62\u8005\u9664\u5916)\u3002\u53c2\u4e0e\u53ef\u8f6c\u503a\u7533\u8d2d\u7684\u6295\u8d44\u8005\u5e94\u5f53\u7b26\u5408\u300a\u5173\u4e8e\u53ef\u8f6c\u6362\u516c\u53f8\u503a\u5238\u9002\u5f53\u6027\u7ba1\u7406\u76f8\u5173\u4e8b\u9879\u7684\u901a\u77e5\u300b(\u6df1\u8bc1\u4e0a\u30142022\u3015587\u53f7)\u7684\u76f8\u5173\u8981\u6c42\u3002\u2462\u672c\u6b21\u53d1\u884c\u7684\u4fdd\u8350\u673a\u6784(\u4e3b\u627f\u9500\u5546)\u7684\u81ea\u8425\u8d26\u6237\u4e0d\u5f97\u53c2\u4e0e\u672c\u6b21\u7533\u8d2d\u3002", "REDEEM_TYPE": null, "EXECUTE_REASON_HS": null, "NOTICE_DATE_HS": null, "NOTICE_DATE_SH": null, "EXECUTE_PRICE_HS": null, "EXECUTE_PRICE_SH": null, "RECORD_DATE_SH": null, "EXECUTE_START_DATESH": null, "EXECUTE_START_DATEHS": null, "EXECUTE_END_DATE": null, "CORRECODE": "370967", "CORRECODE_NAME_ABBR": "\u6653\u9e23\u53d1\u503a", "PUBLIC_START_DATE": "2023-04-06 00:00:00", "CORRECODEO": "380967", "CORRECODE_NAME_ABBRO": "\u6653\u9e23\u914d\u503a", "BOND_START_DATE": "2023-04-10 00:00:00", "SECURITY_START_DATE": "2023-04-04 00:00:00", "SECURITY_SHORT_NAME": "\u6653\u9e23\u80a1\u4efd", "FIRST_PER_PREPLACING": 1.7296, "ONLINE_GENERAL_AAU": 1000, "ONLINE_GENERAL_LWR": 0.0007801534, "INITIAL_TRANSFER_PRICE": 19.43, "TRANSFER_END_DATE": "2029-04-05 00:00:00", "TRANSFER_START_DATE": "2023-10-12 00:00:00", "RESALE_CLAUSE": "(1)\u9644\u52a0\u56de\u552e\u6761\u6b3e\u82e5\u672c\u6b21\u53ef\u8f6c\u503a\u52df\u96c6\u8d44\u91d1\u8fd0\u7528\u7684\u5b9e\u65bd\u60c5\u51b5\u4e0e\u516c\u53f8\u5728\u52df\u96c6\u8bf4\u660e\u4e66\u4e2d\u7684\u627f\u8bfa\u76f8\u6bd4\u51fa\u73b0\u91cd\u5927\u53d8\u5316,\u4e14\u8be5\u53d8\u5316\u88ab\u4e2d\u56fd\u8bc1\u76d1\u4f1a\u8ba4\u5b9a\u4e3a\u6539\u53d8\u52df\u96c6\u8d44\u91d1\u7528\u9014\u7684,\u672c\u6b21\u53ef\u8f6c\u503a\u6301\u6709\u4eba\u4eab\u6709\u4e00\u6b21\u4ee5\u9762\u503c\u52a0\u4e0a\u5f53\u671f\u5e94\u8ba1\u5229\u606f\u7684\u4ef7\u683c\u5411\u516c\u53f8\u5